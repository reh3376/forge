# WhiskeyHouse MES - Staging Environment (Raspberry Pi)

# Database
DB_NAME=whk-mes
DB_USER=admin
DB_PASSWORD=admin

# Redis (no password for staging)
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=user
RABBITMQ_PASS=password
RABBITMQ_URLS=amqp://user:password@rabbitmq:5672

# Backend Port
PORT=3000

# CORS (will add Vercel URL after deployment)
CORS_ORIGINS=http://localhost:4000,https://staging.whiskeyhouse.ngrok.dev
CORS_ENABLED=true
CORS_CREDENTIALS=true

# JWT (copy from your main .env)
JWT_SECRET_KEY=F39CH0.ImvjSmsPIehl=7@Y(bBTo
BCRYPT_SALT=10

# Add your other secrets here
# APP_JWT_SECRET=
# ENTRA_BACKEND_CLIENT_SECRET=
