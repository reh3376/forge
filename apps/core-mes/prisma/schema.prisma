datasource db {
  provider = "mongodb"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  createdAt DateTime @default(now())
  firstName String?
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime @updatedAt
  username  String   @unique
}

model Lot {
  barrels                  Barrel[]
  createdAt                DateTime @default(now())
  createdBy                String   @unique
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  item                     String
  purchaseOrderLoadedIn    String?
  purchaseOrderRejectedLot String?
  updatedAt                DateTime @updatedAt
  updatedBy                String?  @unique
}

model Barrel {
  createdAt    DateTime  @default(now())
  createdBy    String    @unique
  filledAt     DateTime? @default(now())
  filledBy     String    @unique
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  lot          Lot?      @relation(fields: [lotId], references: [id])
  lotId        String?   @db.ObjectId
  serialNumber String
  updatedAt    DateTime  @updatedAt
  updatedBy    String?   @unique
}
