{
  "name": "@whk-recipe-routing/server",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:watch": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "test": "jest",
    "test-coverage": "jest --coverage --coverageReporters json-summary --reporters=default --reporters=jest-junit",
    "seed": "ts-node scripts/seed.ts",
    "db:migrate-save": "prisma migrate dev",
    "db:migrate-up": "prisma migrate deploy",
    "db:clean": "prisma migrate reset",
    "db:init": "run-s \"db:migrate-save -- --name 'initial version'\" db:migrate-up seed",
    "prisma:generate": "prisma generate",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:kong": "docker-compose -f docker-compose.dev.yml --profile kong up -d",
    "package:container": "docker build .",
    "compose:up": "docker-compose up -d",
    "compose:down": "docker-compose down --volumes",
    "lint": "eslint './src/**/*.{ts, tsx}'",
    "lint:fix": "eslint --fix './src/**/*.{ts, tsx}'",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@amplication/opentelemetry-nestjs": "^4.5.0",
    "@apollo/server": "^4.9.4",
    "@nestjs/apollo": "12.1.0",
    "@nestjs/cache-manager": "^2.1.0",
    "@nestjs/common": "10.2.7",
    "@nestjs/config": "3.2.0",
    "@nestjs/core": "10.3.3",
    "@nestjs/graphql": "12.0.9",
    "@nestjs/jwt": "^10.1.1",
    "@nestjs/microservices": "10.2.7",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "10.3.4",
    "@nestjs/serve-static": "4.0.1",
    "@nestjs/swagger": "7.1.13",
    "@prisma/client": "^5.11.0",
    "@types/bcrypt": "5.0.0",
    "@faker-js/faker": "^8.4.1",
    "bcrypt": "5.1.1",
    "cache-manager": "5.2.4",
    "cache-manager-ioredis-yet": "^1.2.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "dotenv": "16.4.5",
    "graphql": "^16.8.1",
    "graphql-type-json": "0.3.2",
    "kafkajs": "^2.2.4",
    "nest-access-control": "^3.1.0",
    "nestjs-pino": "^3.5.0",
    "npm-run-all": "4.1.5",
    "passport": "0.6.0",
    "passport-http": "0.3.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.1.13",
    "ts-node": "10.9.1",
    "type-fest": "2.19.0",
    "validator": "13.11.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.1.18",
    "@nestjs/testing": "^10.2.7",
    "@types/cache-manager": "4.0.4",
    "@types/express": "^4.17.19",
    "@types/graphql-type-json": "0.3.5",
    "@types/jest": "^29.5.5",
    "@types/normalize-path": "3.0.2",
    "@types/passport-http": "0.3.9",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.11.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^7.0.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "jest-junit": "^16.0.0",
    "prettier": "^2.8.0",
    "prisma": "^5.10.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "~5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "modulePathIgnorePatterns": ["<rootDir>/dist/"],
    "collectCoverage": true,
    "coverageReporters": ["json", "html"]
  }
}
