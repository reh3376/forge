+const CREATE_RESULT = {
+  backsetQuantity: 42,
+  cookCompleteTime: new Date(),
+  cookDropTime: new Date(),
+  cookDuration: 42,
+  cookStartTime: new Date(),
+  cookStartedBy: "exampleCookStartedBy",
+  cookerNumber: 42,
+  cornQuantity: 42,
