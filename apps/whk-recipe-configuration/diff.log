+    resource: "Customer",
+    action: "update",
+    possession: "any",
+  })
+  async connectSalesOrders(
+    @common.Param() params: CustomerWhereUniqueInput,
+    @common.Body() body: SalesOrderWhereUniqueInput[]
+  ): Promise<void> {
+    const data = {
+      salesOrders: {
+        connect: body,
+      },
+    };
+    await this.service.updateCustomer({
+      where: params,
+      data,
+      select: { id: true },
+    });
+  }
+
+  @common.Patch("/:id/salesOrders")
+  @UseRoles({
+    resource: "Customer",
+    action: "update",
+    possession: "any",
+  })
+  async updateSalesOrders(
+    @common.Param() params: CustomerWhereUniqueInput,
+    @common.Body() body: SalesOrderWhereUniqueInput[]
+  ): Promise<void> {
+    const data = {
+      salesOrders: {
+        set: body,
+      },
+    };
+    await this.service.updateCustomer({
+      where: params,
+      data,
+      select: { id: true },
+    });
+  }
+
+  @common.Delete("/:id/salesOrders")
+  @UseRoles({
+    resource: "Customer",
+    action: "update",
+    possession: "any",
+  })
+  async disconnectSalesOrders(
+    @common.Param() params: CustomerWhereUniqueInput,
+    @common.Body() body: SalesOrderWhereUniqueInput[]
+  ): Promise<void> {
+    const data = {
+      salesOrders: {
+        disconnect: body,
+      },
+    };
+    await this.service.updateCustomer({
+      where: params,
+      data,
+      select: { id: true },
+    });
+  }
 }
