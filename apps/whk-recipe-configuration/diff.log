+  specialtyQuantity: 42,
+  totalDuration: 42,
+  updatedAt: new Date(),
+  waterQuantity: 42,
+  wheatQuantity: 42,
+};
+const FIND_MANY_RESULT = [
+  {
+    backsetQuantity: 42,
+    cookCompleteTime: new Date(),
+    cookDropTime: new Date(),
+    cookDuration: 42,
+    cookStartTime: new Date(),
+    cookStartedBy: "exampleCookStartedBy",
