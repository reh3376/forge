# overall service port and params
PORT=3000
SERVICE_NAME=whk-recipe-configuration
COMPOSE_PROJECT_NAME=whk-recipe-configuration
BCRYPT_SALT=10

# primary db
DB_NAME=recipe-configuration
DB_USER=admin
DB_PASSWORD=admin
DB_PORT=5432
DB_URL=postgres://admin:admin@localhost:5432/recipe-configuration

# Leverage internal docker network for db connection
#DB_URL=postgres://admin:admin@db/recipe-configuration

JWT_EXPIRATION=2d
JWT_SECRET_KEY=Change_ME!!!
KAFKA_BROKERS=localhost:9092
#KAFKA_BROKERS=kafka # Internal docker network
KAFKA_CLIENT_ID=whk-recipe-configuration
KAFKA_ENABLE_SSL=false
KAFKA_GROUP_ID=whk-recipe-configuration

# json logging
LOG_LEVEL=info

# opentelem & jeager
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=16686
OTEL_COLLECTOR_HOST=localhost
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT_HTTP}

# redis db
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_TTL=5000
REDIS_USERNAME=
