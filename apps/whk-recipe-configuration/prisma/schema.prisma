datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  createdAt DateTime @default(now())
  firstName String?
  id        String   @id @default(cuid())
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime @updatedAt
  username  String   @unique
}

model ParameterType {
  createdAt              DateTime                      @default(now())
  createdBy              String                        @unique
  editedBy               String?                       @unique
  id                     String                        @id @default(cuid())
  itemId                 String?
  recipeId               String?
  recipeParameters       RecipeParameter[]
  schemaVersion          String?                       @default("0001-alpha")
  setpointBooleanValue   Boolean?
  setpointLowerLimit     Float?
  setpointNumericalValue Float?
  setpointType           EnumParameterTypeSetpointType
  setpointUpperLimit     Float?
  typeDescription        String
  typeName               String
  typeRevision           Int                           @default(0)
  typeUnits              String
  updatedAt              DateTime                      @updatedAt
}

model TestParameter {
  active                   Boolean                            @default(true)
  batch                    String?
  className                String
  createdAt                DateTime                           @default(now())
  createdBy                String                             @unique
  editedAt                 DateTime?                          @updatedAt
  editedBy                 String?                            @unique
  id                       String                             @id @default(auto())
  isDefinition             Boolean?                           @default(false)
  itemId                   String
  schemaVersion            String?
  test                     Json?
  testParamDescription     String?
  testParamName            String
  testParamRevision        String?
  testParamUnits           EnumTestParameterTestParamUnits?
  testPass                 Boolean?
  testResult               String?
  testSetpointBooleanValue Boolean?                           @default(true)
  testSetpointLowerLimit   Float?
  testSetpointType         EnumTestParameterTestSetpointType?
  testSetpointUpperLimit   Float?
  testSetpointValue        Float?

  @@map("TestParameters")
}

model RecipeParameter {
  active                     Boolean                               @default(true)
  batch                      String?
  className                  String
  createdAt                  DateTime                              @default(now())
  createdBy                  String                                @unique
  editedAt                   DateTime?                             @updatedAt
  editedBy                   String?                               @unique
  id                         String                                @id @default(cuid())
  itemId                     String
  parameterType              ParameterType?                        @relation(fields: [parameterTypeId], references: [id])
  parameterTypeId            String?
  recipeParamDescription     String?
  recipeParamName            String
  recipeParamRevision        String?
  recipeParamUnits           EnumRecipeParameterRecipeParamUnits?
  recipeSetpointBooleanValue Boolean?                              @default(true)
  recipeSetpointLowerLimit   Float?
  recipeSetpointType         EnumRecipeParameterRecipeSetpointType
  recipeSetpointUpperLimit   Float?
  schemaVersion              String?                               @default("0001-alpha")
  sequencerParameters        Json?

  @@map("RecipeParameters")
}

model Instruction {
  active              Boolean?        @default(false)
  createdAt           DateTime        @default(now())
  createdBy           String          @unique
  editedBy            String?         @unique
  filePath            String
  id                  String          @id @default(cuid())
  instructionRevision Int             @default(0)
  operationStep       OperationStep[]
  routes              Json?
  schemaVersion       String          @default("0001-alpha")
  updatedAt           DateTime        @updatedAt
}

model OperationStep {
  bomId                    String?
  className                String?
  createdAt                DateTime?     @default(now())
  createdBy                String        @unique
  editedAt                 DateTime?     @updatedAt
  editedBy                 String?       @unique
  id                       String        @id @default(auto())
  instructions             Instruction[]
  operations               Operation     @relation(fields: [operationId], references: [id])
  operationId              String
  operationStepDescription String?
  operationStepName        String
  operationStepRevision    Int?          @default(0)
  operationStepSequence    Int?
  recipeId                 String?
  schemaVersion            String?
  sequenceOperation        Boolean?
  tests                    Json?

  @@map("operationSteps")
}

model Operation {
  active                  Boolean?        @default(true)
  createdAt               DateTime?       @default(now())
  createdBy               String          @unique
  editedBy                String?         @unique
  globalUuid              String?         @default(uuid())
  id                      String          @id @default(auto())
  operationDescription    String
  operationName           String
  operationRevision       Int             @default(0)
  operationSequenceNumber Int             @unique @default(0)
  operationSteps          OperationStep[]
  route                   Json?
  schemaVersion           String?         @default("0001-alpha")
  updatedAt               DateTime?       @updatedAt

  @@map("Operations")
}

enum EnumParameterTypeSetpointType {
  Boolean
  Numeric
}

enum EnumTestParameterTestParamUnits {
  Lbs
  Perc
  Gal
  Bu
  PassFail
}

enum EnumTestParameterTestSetpointType {
  Boolean
  Numerical
}

enum EnumRecipeParameterRecipeParamUnits {
  Lbs
  Gal
  Percentage
  PassFail
  Seconds
  Minutes
  DateTime
  Feet
  Bushels
}

enum EnumRecipeParameterRecipeSetpointType {
  Boolean
  Numeric
}
