datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  createdAt DateTime @default(now())
  firstName String?
  id        String   @id @default(cuid())
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime @updatedAt
  username  String   @unique
}

model PhaseParameter {
  active                 Boolean?                       @default(false)
  classId                PhaseParameter?                @relation(name: "PhaseParameterClassIdPhaseParameterInstances", fields: [classIdId], references: [id])
  classIdId              String?
  createdAt              DateTime                       @default(now())
  createdBy              String
  description            String
  editedBy               String?
  equipmentPhases        EquipmentPhase[]
  globalId               String?                        @unique @default(cuid())
  id                     String                         @id @default(cuid())
  instances              PhaseParameter[]               @relation(name: "PhaseParameterClassIdPhaseParameterInstances")
  isClassDef             Boolean                        @default(false)
  isStaticParameter      Boolean?                       @default(false)
  itemId                 String?
  name                   String
  recipeId               String?
  revision               Int?                           @default(0)
  schemaVersion          String?                        @default("0001-alpha")
  setpointBooleanValue   Boolean?
  setpointLowerLimit     Float?
  setpointNumericalValue Float?
  setpointType           EnumPhaseParameterSetpointType
  setpointUpperLimit     Float?
  staticName             EnumPhaseParameterStaticName?
  stringValue            String?
  units                  String
  updatedAt              DateTime                       @updatedAt
}

model TestParameter {
  active                   Boolean                            @default(true)
  schemaVersion            String?
  testSetpointValue        Float?
  testParamUnits           String
  testSetpointUpperLimit   Float?
  testParamRevision        String?
  testSetpointLowerLimit   Float?
  testResult               Float?
  testPass                 Boolean?                           @default(false)
  testSetpointBooleanValue Boolean?
  testedAt                 DateTime?
  createdBy                String
  testSetpointType         EnumTestParameterTestSetpointType?
  testedBy                 String?
  tooltip                  String?
  name                     String
  updatedAt                DateTime?                          @updatedAt
  updatedBy                String?
  testDetails              String?
  equipmentPhases          EquipmentPhase[]
  isClassDef               Boolean?                           @default(false)
  classId                  TestParameter?                     @relation(name: "TestParameterClassIdTestParameterInstances", fields: [classIdId], references: [id])
  classIdId                String?
  createdAt                DateTime                           @default(now())
  description              String?
  globalId                 String?                            @default(cuid())
  id                       String                             @id @default(cuid())
  instances                TestParameter[]                    @relation(name: "TestParameterClassIdTestParameterInstances")
  item                     Item[]
  itemGroup                String?
  itemReceipt              ItemReceipt?                       @relation(fields: [itemReceiptId], references: [id])
  itemReceiptId            String?
  // PurchaseOrder            PurchaseOrder?                     @relation(fields: [purchaseOrderId], references: [id])
  // purchaseOrderId          String?
  purchaseOrder            PurchaseOrder[]
  required                 Boolean?                           @default(true)
}

model RecipeParameter {
  recipeSetpointType         EnumRecipeParameterRecipeSetpointType
  revision                   Int?                                  @default(0)
  recipeSetpointUpperLimit   Float?
  recipeParamName            String
  className                  String
  active                     Boolean                               @default(true)
  createdBy                  String
  recipeSetpointLowerLimit   Float?
  updatedAt                  DateTime?                             @updatedAt
  id                         String                                @id @default(cuid())
  recipeParamDescription     String?
  updatedBy                  String?
  recipeSetpointBooleanValue Boolean?                              @default(true)
  createdAt                  DateTime                              @default(now())
  recipeParamUnits           String?
  schemaVersion              String?                               @default("0001-alpha")
  isClassDefinition          Boolean?                              @default(false)
  classId                    RecipeParameter?                      @relation(name: "RecipeParameterClassIdRecipeParameterInstances", fields: [classIdId], references: [id])
  classIdId                  String?
  instances                  RecipeParameter[]                     @relation(name: "RecipeParameterClassIdRecipeParameterInstances")
  globalId                   String?                               @default(cuid())
  recipeNumericalSetpoint    Float?
  recipe                     Recipe[]
  description                String?
}

model Instruction {
  active         Boolean?         @default(false)
  createdAt      DateTime         @default(now())
  createdBy      String
  editedBy       String?
  equipmentPhase EquipmentPhase[]
  filePath       String
  globalId       String?          @unique @default(cuid())
  id             String           @id @default(cuid())
  name           String?
  revision       Int              @default(0)
  schemaVersion  String?          @default("0001-alpha")
  updatedAt      DateTime         @updatedAt

  @@unique([name, revision])
}

model EquipmentPhase {
  active                 Boolean?                   @default(true)
  bomItem                BomItem[]
  classId                EquipmentPhase?            @relation(name: "EquipmentPhaseClassIdEquipmentPhaseInstances", fields: [classIdId], references: [id])
  classIdId              String?
  className              String?
  createdAt              DateTime?                  @default(now())
  createdBy              String
  description            String?
  editedAt               DateTime?                  @updatedAt
  editedBy               String?
  globalId               String?                    @unique @default(cuid())
  id                     String                     @id @default(cuid())
  instances              EquipmentPhase[]           @relation(name: "EquipmentPhaseClassIdEquipmentPhaseInstances")
  instructions           Instruction[]
  isClassDefinition      Boolean?                   @default(false)
  message                String?
  name                   EnumEquipmentPhaseName
  operation              Operation                  @relation(fields: [operationId], references: [id])
  operationId            String
  operationSequenceIndex Int?
  path                   String?
  phaseParameters        PhaseParameter[]
  revision               Int?                       @default(0)
  schemaVersion          String?                    @default("0001-b")
  stepType               EnumEquipmentPhaseStepType @default(NotRequired)
  testParameters         TestParameter[]
}

model Operation {
  abbreviation            String
  active                  Boolean?                   @default(true)
  auxiliaryPhases         Json?
  classId                 Operation?                 @relation(name: "OperationClassIdOperationInstances", fields: [classIdId], references: [id])
  classIdId               String?
  createdAt               DateTime?                  @default(now())
  createdBy               String
  description             String
  editedBy                String?
  equipmentPhases         EquipmentPhase[]
  fermentationChemistries FermentationChemistry[]
  fermentationDayData     FermentationDayDatum[]
  fermentationSettingData FermentationSettingDatum[]
  globalId                String?                    @default(cuid())
  id                      String                     @id @default(cuid())
  instances               Operation[]                @relation(name: "OperationClassIdOperationInstances")
  isClassDefinition       Boolean?                   @default(false)
  lotId                   String?                    @unique
  mashingData             MashingDatum[]
  name                    EnumOperationName
  path                    String?
  procedureSequenceIndex  Int                        @default(0)
  revision                Int?                       @default(0)
  schemaVersion           String?                    @default("0001-b")
  unitProcedure           UnitProcedure?             @relation(fields: [unitProcedureId], references: [id])
  unitProcedureId         String?
  updatedAt               DateTime?                  @updatedAt
}

model Procedure {
  active            Boolean?           @default(true)
  classId           Procedure?         @relation(name: "ProcedureClassIdProcedureInstances", fields: [classIdId], references: [id])
  classIdId         String?
  createdAt         DateTime           @default(now())
  createdBy         String
  description       String?
  globalId          String?            @unique @default(cuid())
  id                String             @id @default(cuid())
  instances         Procedure[]        @relation(name: "ProcedureClassIdProcedureInstances")
  isClassDefinition Boolean?
  name              EnumProcedureName?
  revision          Int?               @default(0)
  schemaVersion     String?            @default("0001-b")
  unitProcedures    UnitProcedure[]
  updatedAt         DateTime           @updatedAt
  updatedBy         String?

  @@unique([name, revision, active, isClassDefinition])
}

model Recipe {
  Recipe                         String
  active                         Boolean?                        @default(true)
  batches                        Batch[]
  classId                        Recipe?                         @relation(name: "RecipeClassIdRecipeInstances", fields: [classIdId], references: [id])
  classIdId                      String?
  cooksPerFerm                   Int?                            @default(3)
  createdAt                      DateTime                        @default(now())
  createdBy                      String
  customer                       Customer                        @relation(fields: [customerId], references: [id])
  customerId                     String
  customerCode                   String?
  estimatedAbv                   Float?
  globalId                       String?                         @unique @default(cuid())
  id                             String                          @id @default(cuid())
  instances                      Recipe[]                        @relation(name: "RecipeClassIdRecipeInstances")
  isClassDefinition              Boolean?                        @default(true)
  item                           Item?                           @relation(fields: [itemId], references: [id])
  itemId                         String?
  lots                           Lot[]
  mashingProtocol                MashingProtocol?                @relation(fields: [mashingProtocolId], references: [id])
  mashingProtocolId              String?
  parameters                     RecipeParameter[]
  productionOrderRecipeInstances ProductionOrderRecipeInstance[]
  productionOrders               ProductionOrder[]
  recipeBoms                     RecipeBom[]
  recipeGroup                    RecipeGroup?                    @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId                  String?
  revision                       Int?                            @default(0)
  scheduleOrders                 ScheduleOrder[]
  schemaVersion                  String?                         @default("0001-b")
  targetProof                    Float?
  totalCooks                     Int?
  totalFermenters                Int?
  unitProcedures                 UnitProcedure[]
  updatedAt                      DateTime                        @updatedAt
  updatedBy                      String?
  whiskeyType                    EnumRecipeWhiskeyType?          @default(RyeBourbon)
}

model Bom {
  bomItem               BomItem[]
  bomName               String
  bomRevision           String
  bomType               String?
  className             String?
  createdAt             DateTime          @default(now())
  createdBy             String
  editedAt              DateTime          @updatedAt
  editedBy              String?
  effectiveEndDate      DateTime?
  effectiveStartDate    DateTime?         @default(now())
  erpId                 String?           @unique
  globalId              String?           @unique @default(cuid())
  id                    String            @id @default(cuid())
  inactive              Boolean?          @default(false)
  item                  Item              @relation(fields: [itemId], references: [id])
  itemId                String
  mashingData           MashingDatum[]
  notes                 String?
  productionOrder       ProductionOrder[]
  schemaVersion         String?           @default("0001-alpha")
  unitProcedure         UnitProcedure[]   @relation(name: "BomsOnUnitProcedure")
  unitProceduresPrimary UnitProcedure[]   @relation(name: "primaryBom")
}

model ScheduleOrderQueue {
  createdAt             DateTime                             @default(now())
  createdBy             String
  globalId              String?                              @unique @default(cuid())
  id                    String                               @id @default(cuid())
  nextOperation         EnumScheduleOrderQueueNextOperation?
  nextUnitProcedure     UnitProcedure?                       @relation(fields: [nextUnitProcedureId], references: [id])
  nextUnitProcedureId   String?
  nextUnitProcedureName String?
  queueIndex            Int?                                 @unique
  scheduleOrder         ScheduleOrder?
  schemaVersion         String?                              @default("0001-b")
  updatedAt             DateTime                             @updatedAt
  updatedBy             String?

  @@unique([queueIndex, nextUnitProcedureId])
}

model UnitProcedure {
  abbreviation        String?
  active              Boolean?              @default(true)
  boms                Bom?                  @relation(name: "BomsOnUnitProcedure", fields: [bomsId], references: [id])
  bomsId              String?
  classId             UnitProcedure?        @relation(name: "UnitProcedureClassIdUnitProcedureInstances", fields: [classIdId], references: [id])
  classIdId           String?
  createdAt           DateTime              @default(now())
  createdBy           String
  description         String?
  globalId            String?               @unique @default(cuid())
  id                  String                @id @default(cuid())
  instances           UnitProcedure[]       @relation(name: "UnitProcedureClassIdUnitProcedureInstances")
  isClassDef          Boolean?              @default(false)
  name                EnumUnitProcedureName
  operations          Operation[]
  path                String?
  primaryBom          Bom?                  @relation(name: "primaryBom", fields: [primaryBomId], references: [id])
  primaryBomId        String?
  procedure           Procedure             @relation(fields: [procedureId], references: [id])
  procedureId         String
  recipe              Recipe[]
  revision            Int?                  @default(0)
  scheduleOrderQueues ScheduleOrderQueue[]
  schemaVersion       String?               @default("0001-b")
  updatedAt           DateTime              @updatedAt
  updatedBy           String?
}

model RecipeGroup {
  createdAt        DateTime          @default(now())
  createdBy        String
  globalId         String?           @unique @default(cuid())
  id               String            @id @default(cuid())
  productionOrders ProductionOrder[]
  recipe           String
  recipes          Recipe[]
  revision         Int?              @default(0)
  scheduleOrders   ScheduleOrder[]
  schemaVersion    String?           @default("0001-alpha")
  updatedAt        DateTime          @updatedAt
  updatedBy        String?

  @@unique([recipe, revision])
}

model ProductionOrder {
  id                             String                          @id @default(cuid())
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  bom                            Bom                             @relation(fields: [bomId], references: [id])
  bomId                          String
  className                      String?
  complete                       Boolean?                        @default(false)
  createdBy                      String
  estimatedBarrelsPerFermenter   Float?
  estimatedPGsPerBbl             Float?
  estimatedPGsPerBushel          Float?
  inProcess                      Boolean?                        @default(false)
  updatedBy                      DateTime?
  item                           Item                            @relation(fields: [fgItemId], references: [id])
  fgItemId                       String
  recipe                         Recipe?                         @relation(fields: [recipeId], references: [id])
  recipeId                       String?
  recipeGroup                    RecipeGroup?                    @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId                  String?
  customer                       Customer                        @relation(fields: [customerId], references: [id])
  customerId                     String
  scheduled                      Boolean?                        @default(false)
  schemaVersion                  String?                         @default("0001-alpha")
  startDate                      DateTime?                       @default(now())
  endDate                        DateTime?
  status                         EnumProductionOrderStatus?      @default(Initiated)
  scheduleOrder                  ScheduleOrder?                  @relation(fields: [scheduleOrderId], references: [id])
  scheduleOrderId                String?
  // salesOrder                    SalesOrder                      @relation(fields: [salesOrderId], references: [id])
  // salesOrderId                  String                          @unique
  globalId                       String?                         @default(cuid())
  // productionOrderUnitProcedures ProductionOrderUnitProcedure[]
  fermentationChemistries        FermentationChemistry[]
  fermentationDayData            FermentationDayDatum[]
  lots                           Lot[]
  customerCode                   String?
  units                          String?
  quantity                       Int?
  name                           String?                         @unique
  totalFermenters                Int?
  totalCooks                     Int?
  executedCooks                  Int?
  executedFermenters             Int?
  productionOrderRecipeInstances ProductionOrderRecipeInstance[]
  SalesOrder                     SalesOrder[]
}

model ScheduleOrder {
  actualEnd                        DateTime?
  actualStart                      DateTime?
  createdAt                        DateTime                 @default(now())
  createdBy                        String?
  customers                        Customer[]
  duration                         Float?
  durationUnits                    String?                  @default("Hours")
  estimatedBarrelingStartTime      DateTime?
  estimatedDistillationDuration    Float?
  estimatedDistillationStartTime   DateTime?
  estimatedEnd                     DateTime?
  estimatedFermentationDuration    Float?
  estimatedFermentationStartTime   DateTime?
  estimatedMashingDuration         Float?
  estimatedMashingStartTime        DateTime?
  estimatedProcessingStartTime     DateTime?
  estimatedStart                   DateTime?
  estimatedTotalProductionDuration Float?
  globalId                         String?                  @unique @default(cuid())
  id                               String                   @id @default(cuid())
  name                             String?                  @unique
  productionOrderAllocation        Json
  productionOrders                 ProductionOrder[]
  recipeGroup                      RecipeGroup              @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId                    String
  recipeName                       String
  scheduleOrderQueues              ScheduleOrderQueue?      @relation(fields: [scheduleOrderQueueId], references: [id])
  scheduleOrderRecipe              Recipe?                  @relation(fields: [scheduleOrderRecipeId], references: [id])
  scheduleOrderRecipeId            String?
  status                           EnumScheduleOrderStatus? @default(Created)
  totalBarrels                     Int?
  totalProofGallons                Float?
  updatedAt                        DateTime                 @updatedAt
  updatedBy                        String?
  scheduleOrderQueueId             String?                  @unique
}

model Item {
  active             Boolean?            @default(true)
  additiveActuals    AdditiveActual[]
  baseBomItem        Boolean?            @default(false)
  bomItems           BomItem[]
  bomsWipItem        Bom[]
  createdAt          DateTime            @default(now())
  createdBy          String
  erpId              String              @unique
  globalId           String?             @unique @default(cuid())
  id                 String              @id @default(cuid())
  inventories        Inventory[]
  inventoryLogs      InventoryLog[]
  inventoryTransfers InventoryTransfer[]
  itemClass          String?
  itemDescription    String?
  itemGroup          String?
  itemName           String
  itemNumber         String
  itemReceipts       ItemReceipt[]
  itemRevision       Int?                @default(0)
  itemType           String
  lotContinerItem    Lot?                @relation(name: "continerItem")
  lots               Lot[]               @relation(name: "ItemOnLots")
  productionOrders   ProductionOrder[]
  purchaseOrders     PurchaseOrder[]
  recipeBoms         RecipeBomItem[]
  recipes            Recipe[]
  salesOrders        SalesOrder[]
  schemaVersion      String?
  testParameters     TestParameter[]
  updatedAt          DateTime            @updatedAt
  updatedBy          String?
  vendor             Vendor?             @relation(fields: [vendorId], references: [id])
  vendorId           String?
}

model ItemGroup {
  createdAt   DateTime @default(now())
  description String?
  globalId    String?  @unique @default(cuid())
  id          String   @id @default(cuid())
  name        String
  updatedAt   DateTime @updatedAt
}

model Customer {
  address          String
  batches          Batch[]
  createdAt        DateTime          @default(now())
  createdBy        String
  customerCode     String?
  description      String?
  editedBy         String?
  email            String?
  furnishedLots    Lot[]
  globalId         String?           @unique @default(cuid())
  id               String            @id @default(cuid())
  inventoryLog     InventoryLog?     @relation(fields: [inventoryLogId], references: [id])
  inventoryLogId   String?
  name             String
  phone            String?
  productionOrders ProductionOrder[]
  recipes          Recipe[]
  revision         Int               @default(0)
  salesOrders      SalesOrder[]
  scheduleOrders   ScheduleOrder[]
  schemaVersion    String?           @default("0001-alpha")
  updatedAt        DateTime          @updatedAt

  @@unique([revision, name])
}

model PurchaseOrder {
  acceptedLots                Lot[]
  asset                       Asset?                          @relation(fields: [assetId], references: [id])
  assetId                     String?
  className                   String?
  complete                    Boolean?                        @default(false)
  createdAt                   DateTime?                       @default(now())
  createdBy                   String
  erpId                       String                          @unique
  globalId                    String                          @unique @default(cuid())
  id                          String                          @id @default(cuid())
  item                        Item[]
  itemReceipts                ItemReceipt[]
  lineItems                   Json?
  lotsRejected                PurchaseOrder[]                 @relation(name: "lotsRejected")
  name                        String
  purchaseOrderReceiptDate    DateTime?
  purchaseOrderReceived       Boolean?                        @default(false)
  purchaseOrderRejectedLots   PurchaseOrder?                  @relation(name: "lotsRejected", fields: [purchaseOrderRejectedLotsId], references: [id])
  purchaseOrderRejectedLotsId String?
  qualityTests                TestParameter[]
  receiptStatus               EnumPurchaseOrderReceiptStatus? @default(InitializedNotReceived)
  receivedQuantity            Int?
  revision                    Int?                            @default(0)
  schemaVersion               String?
  totalOrderQuantity          Int?
  transactionGroup            String?
  updatedAt                   DateTime?                       @updatedAt
  updatedBy                   String?
  vendor                      Vendor?                         @relation(fields: [vendorId], references: [id])
  vendorId                    String?

  @@unique([name, revision])
}

model SalesOrder {
  createdAt         DateTime         @default(now())
  createdBy         String
  customer          Customer?        @relation(fields: [customerId], references: [id])
  customerId        String?
  customerCode      String?
  erpId             String?          @unique
  globalId          String           @unique @default(cuid())
  id                String           @id @default(cuid())
  item              Item[]
  lineItems         Json?
  name              String?          @unique
  orderType         String?
  productionOrders  ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  quantity          Int
  requestedShipDate DateTime?
  revision          Int              @default(0)
  schemaVersion     String?          @default("0001-alpha")
  updatedAt         DateTime         @updatedAt
  updatedBy         String?
  productionOrderId String?
}

model Test {
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  createdBy         String
  editedAt          DateTime? @updatedAt
  editedBy          String?
  globalId          String?   @unique @default(cuid())
  id                String    @id @default(cuid())
  isClassDefinition Boolean?  @default(false)
  schemaVersion     String?
  testDescription   String?
  testName          String
  testRevision      Int?      @default(0)
}

model Asset {
  assetPath               String                  @unique
  assetType               EnumAssetAssetType
  batches                 Batch[]
  children                Asset[]                 @relation(name: "AssetChildrenAssetParent")
  createdAt               DateTime                @default(now())
  createdBy               String
  description             String
  fermentationChemistries FermentationChemistry[]
  fermentationDayData     FermentationDayDatum[]
  globalId                String?                 @unique @default(cuid())
  id                      String                  @id @default(cuid())
  inventories             Inventory[]
  inventoryLogs           InventoryLog[]
  inventoryTransfersFrom  InventoryTransfer[]     @relation(name: "fromLocation")
  inventoryTransfersTo    InventoryTransfer[]     @relation(name: "inventoryTransfersTo")
  itemReceipts            ItemReceipt[]
  lotProofingTank         Lot[]                   @relation(name: "lotProofingTank")
  lotTankofOrigin         Lot[]                   @relation(name: "lotTankofOrigin")
  lots                    Lot[]                   @relation(name: "fromAsset")
  lotsFilledFrom          Lot[]                   @relation(name: "filledFrom")
  mashingData             MashingDatum[]
  name                    String
  parent                  Asset?                  @relation(name: "AssetChildrenAssetParent", fields: [parentId], references: [id])
  parentId                String?
  proofInitial            Float?
  purchaseOrders          PurchaseOrder[]
  revision                Int?                    @default(0)
  schemaVersion           String                  @default("0001-alpha")
  status                  EnumAssetStatus?        @default(InService)
  updatedAt               DateTime                @updatedAt
  updatedBy               String?
  MashDatum               MashDatum[]

  @@unique([name, revision])
}

model ItemReceipt {
  createdAt       DateTime               @default(now())
  createdBy       String
  driver          String
  globalId        String?                @unique @default(cuid())
  id              String                 @id @default(cuid())
  inventories     Inventory[]
  item            Item                   @relation(fields: [itemId], references: [id])
  itemId          String
  loadId          Int?                   @default(autoincrement())
  lots            Json?
  purchaseOrder   PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?
  quantity        Float
  schemaVersion   String?                @default("0001-b")
  status          EnumItemReceiptStatus? @default(InProgress)
  supplierLot     String?
  tests           TestParameter[]
  testsPassed     Boolean?               @default(false)
  toAsset         Asset?                 @relation(fields: [toAssetId], references: [id])
  toAssetId       String?
  units           String
  updatedAt       DateTime               @updatedAt
  updatedBy       String?
  weighIn         Float?
  weighOut        Float?
  siloNumber      Int?
  // asset           Asset?                 @relation(fields: [assetId], references: [id])
  // assetId         String?
}

model Lot {
  avgBblFillByPg              Float?
  avgBblFillByWg              Float?
  avgPGsFerm                  Float?
  batches                     Batch[]
  bblEntryProof               Float?
  bblOem                      String?
  bblTotal                    Int?
  bblType                     String?
  bomItems                    BomItem[]
  confirmed                   Boolean?            @default(false)
  continerItem                Item?               @relation(name: "continerItem", fields: [continerItemId], references: [id])
  continerItemId              String?             @unique
  createdAt                   DateTime            @default(now())
  createdBy                   String?
  densityFinal                Float?
  externalId                  String?             @unique
  filledFrom                  Asset?              @relation(name: "filledFrom", fields: [filledFromId], references: [id])
  filledFromId                String?
  filledFromString            String?
  finalVolume                 Float?
  finalWeight                 Float?
  fromAsset                   Asset?              @relation(name: "fromAsset", fields: [fromAssetId], references: [id])
  fromAssetId                 String?
  furnishingCustomer          Customer?           @relation(fields: [furnishingCustomerId], references: [id])
  furnishingCustomerId        String?
  globalId                    String?             @unique @default(cuid())
  grainLbsFerm                Float?
  grainLbsPg                  Float?
  id                          String              @id @default(cuid())
  initialVolume               Float?
  initialWeight               Float?
  inventoryTransfers          InventoryTransfer[]
  isRawMaterial               Boolean?            @default(false)
  item                        Item[]              @relation(name: "ItemOnLots")
  lotAlphaChar                String?
  lotCreatedAt                DateTime?           @default(now())
  lotNumber                   String              @unique
  notes                       String?
  pgLosses                    Float?
  productionOrder             ProductionOrder?    @relation(fields: [productionOrderId], references: [id])
  productionOrderId           String?
  proofInitial                Float?
  proofingTank                Asset?              @relation(name: "lotProofingTank", fields: [proofingTankId], references: [id])
  proofingTankId              String?
  purchaseOrderAcceptedLots   PurchaseOrder?      @relation(fields: [purchaseOrderAcceptedLotsId], references: [id])
  purchaseOrderAcceptedLotsId String?
  recipe                      Recipe?             @relation(fields: [recipeId], references: [id])
  recipeId                    String?
  schemaVersion               String?             @default("0001-b")
  standardYield               Float?
  tankOfOrigin                Asset?              @relation(name: "lotTankofOrigin", fields: [tankOfOriginId], references: [id])
  tankOfOriginId              String?
  status                      EnumLotStatus?      @default(Started)
  totalFermenters             Float?
  totalPGs                    Float?
