datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  createdAt DateTime @default(now())
  firstName String?
  id        String   @id @default(cuid())
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime @updatedAt
  username  String   @unique
}

model PhaseParameter {
  active                 Boolean?                       @default(false)
  classId                PhaseParameter?                @relation(name: "PhaseParameterClassIdPhaseParameterInstances", fields: [classIdId], references: [id])
  classIdId              String?
  createdAt              DateTime                       @default(now())
  createdBy              String
  description            String
  editedBy               String?
  equipmentPhase         EquipmentPhase?                @relation(fields: [equipmentPhaseId], references: [id])
  equipmentPhaseId       String?
  id                     String                         @id @default(cuid())
  instances              PhaseParameter[]               @relation(name: "PhaseParameterClassIdPhaseParameterInstances")
  isClassDef             Boolean                        @default(false)
  isStaticParameter      Boolean?                       @default(false)
  itemId                 String?
  name                   String
  recipeId               String?
  revision               Int?                           @default(0)
  schemaVersion          String?                        @default("0001-alpha")
  setpointBooleanValue   Boolean?
  setpointLowerLimit     Float?
  setpointNumericalValue Float?
  setpointType           EnumPhaseParameterSetpointType
  setpointUpperLimit     Float?
  staticName             EnumPhaseParameterStaticName?
  units                  String
  updatedAt              DateTime                       @updatedAt

  @@unique([name, revision, isClassDef])
}

model TestParameter {
  active                   Boolean                            @default(true)
  classId                  TestParameter?                     @relation(name: "TestParameterClassIdTestParameterInstances", fields: [classIdId], references: [id])
  classIdId                String?
  createdAt                DateTime                           @default(now())
  createdBy                String
  description              String?
  editedAt                 DateTime?                          @updatedAt
  editedBy                 String?
  equipmentPhases          EquipmentPhase[]
  id                       String                             @id @default(cuid())
  instances                TestParameter[]                    @relation(name: "TestParameterClassIdTestParameterInstances")
  isClassDef               Boolean?                           @default(false)
  name                     String
  schemaVersion            String?
  testDetails              String?
  testParamRevision        String?
  testParamUnits           EnumTestParameterTestParamUnits?
  testPass                 Boolean?
  testResult               Json?
  testSetpointBooleanValue Boolean?                           @default(true)
  testSetpointLowerLimit   Float?
  testSetpointType         EnumTestParameterTestSetpointType?
  testSetpointUpperLimit   Float?
  testSetpointValue        Float?
  tooltip                  String?
}

model RecipeParameter {
  active                     Boolean                               @default(true)
  batch                      String?
  classId                    RecipeParameter?                      @relation(name: "recipeParameters", fields: [classIdId], references: [id])
  classIdId                  String?
  className                  String
  createdAt                  DateTime                              @default(now())
  createdBy                  String
  editedAt                   DateTime?                             @updatedAt
  editedBy                   String?
  id                         String                                @id @default(cuid())
  isClassDefinition          Boolean?                              @default(false)
  itemId                     String
  recipeParamDescription     String?
  recipeParameters           RecipeParameter[]                     @relation(name: "recipeParameters")
  recipeParamName            String
  recipeParamUnits           EnumRecipeParameterRecipeParamUnits?
  recipeSetpointBooleanValue Boolean?                              @default(true)
  recipeSetpointLowerLimit   Float?
  recipeSetpointType         EnumRecipeParameterRecipeSetpointType
  recipeSetpointUpperLimit   Float?
  revision                   Int?                                  @default(0)
  schemaVersion              String?                               @default("0001-alpha")
  sequencerParameters        Json?
}

model Instruction {
  active         Boolean?         @default(false)
  createdAt      DateTime         @default(now())
  createdBy      String
  editedBy       String?
  equipmentPhase EquipmentPhase[]
  filePath       String
  id             String           @id @default(cuid())
  name           String?
  revision       Int              @default(0)
  schemaVersion  String?          @default("0001-alpha")
  updatedAt      DateTime         @updatedAt

  @@unique([name, revision])
}

model EquipmentPhase {
  active                 Boolean?               @default(true)
  classId                EquipmentPhase?        @relation(name: "EquipmentPhaseClassIdEquipmentPhaseInstances", fields: [classIdId], references: [id])
  classIdId              String?
  className              String?
  createdAt              DateTime?              @default(now())
  createdBy              String
  description            String?
  editedAt               DateTime?              @updatedAt
  editedBy               String?
  id                     String                 @id @default(cuid())
  instances              EquipmentPhase[]       @relation(name: "EquipmentPhaseClassIdEquipmentPhaseInstances")
  instructions           Instruction[]
  isClassDefinition      Boolean?               @default(false)
  name                   EnumEquipmentPhaseName
  operation              Operation              @relation(fields: [operationId], references: [id])
  operationId            String
  operationSequenceIndex Int?
  path                   String?
  phaseParameters        PhaseParameter[]
  revision               Int?                   @default(0)
  schemaVersion          String?                @default("0001-b")
  testParameters         TestParameter[]

  @@unique([name, revision, active, isClassDefinition])
}

model Operation {
  abbreviation           String
  active                 Boolean?          @default(true)
  classId                Operation?        @relation(name: "OperationClassIdOperationInstances", fields: [classIdId], references: [id])
  classIdId              String?
  createdAt              DateTime?         @default(now())
  createdBy              String
  description            String
  editedBy               String?
  equipmentPhases        EquipmentPhase[]
  id                     String            @id @default(cuid())
  instances              Operation[]       @relation(name: "OperationClassIdOperationInstances")
  isClassDefinition      Boolean?          @default(false)
  name                   EnumOperationName
  path                   String?
  procedureSequenceIndex Int               @default(0)
  revision               Int               @default(0)
  schemaVersion          String?           @default("0001-b")
  unitProcedure          UnitProcedure?    @relation(fields: [unitProcedureId], references: [id])
  unitProcedureId        String?
  updatedAt              DateTime?         @updatedAt

  @@unique([name, revision, active, isClassDefinition])
}

model Procedure {
  active            Boolean?           @default(true)
  classId           Procedure?         @relation(name: "ProcedureClassIdProcedureInstances", fields: [classIdId], references: [id])
  classIdId         String?
  createdAt         DateTime           @default(now())
  createdBy         String
  description       String?
  id                String             @id @default(cuid())
  instances         Procedure[]        @relation(name: "ProcedureClassIdProcedureInstances")
  isClassDefinition Boolean?
  name              EnumProcedureName?
  revision          Int?               @default(0)
  schemaVersion     String?            @default("0001-b")
  unitProcedures    UnitProcedure[]
  updatedAt         DateTime           @updatedAt
  updatedBy         String?

  @@unique([name, revision, active, isClassDefinition])
}

model Recipe {
  active           Boolean?          @default(true)
  createdAt        DateTime          @default(now())
  createdBy        String
  customerId       String
  id               String            @id @default(cuid())
  itemDescription  String?
  itemId           String
  productionOrders ProductionOrder[]
  Recipe           String
  recipeGroup      RecipeGroup?      @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId    String?
  revision         Int?              @default(0)
  scheduleOrders   ScheduleOrder[]
  schemaVersion    String?           @default("0001-b")
  unitProcedures   UnitProcedure[]
  updatedAt        DateTime          @updatedAt
  updatedBy        String?

  @@unique([itemId, customerId])
}

model Bom {
  bomItem               Item[]            @relation(name: "bomItem")
  bomName               String
  bomRevision           Int?              @default(0)
  className             String?
  createdAt             DateTime          @default(now())
  createdBy             String
  editedAt              DateTime          @updatedAt
  editedBy              String?
  id                    String            @id @default(cuid())
  productionOrder       ProductionOrder[]
  schemaVersion         String?           @default("0001-alpha")
  unitProcedure         UnitProcedure[]   @relation(name: "BomsOnUnitProcedure")
  unitProceduresPrimary UnitProcedure[]   @relation(name: "primaryBom")
  wipItem               Item              @relation(name: "bomsWipItem", fields: [wipItemId], references: [id])
  wipItemId             String
}

model ScheduleOrderQueue {
  createdAt          DateTime            @default(now())
  createdBy          String
  id                 String              @id @default(cuid())
  productionSchedule ProductionSchedule?
  queueIndex         Int?                @unique
  schemaVersion      String?             @default("0001-b")
  updatedAt          DateTime            @updatedAt
  updatedBy          String?
}

model UnitProcedure {
  active        Boolean?              @default(true)
  boms          Bom?                  @relation(name: "BomsOnUnitProcedure", fields: [bomsId], references: [id])
  bomsId        String?
  classId       UnitProcedure?        @relation(name: "UnitProcedureClassIdUnitProcedureInstances", fields: [classIdId], references: [id])
  classIdId     String?
  createdAt     DateTime              @default(now())
  createdBy     String
  description   String?
  id            String                @id @default(cuid())
  instances     UnitProcedure[]       @relation(name: "UnitProcedureClassIdUnitProcedureInstances")
  isClassDef    Boolean?              @default(false)
  name          EnumUnitProcedureName
  operations    Operation[]
  primaryBom    Bom?                  @relation(name: "primaryBom", fields: [primaryBomId], references: [id])
  primaryBomId  String?
  procedure     Procedure             @relation(fields: [procedureId], references: [id])
  procedureId   String
  recipe        Recipe[]
  revision      Int?                  @default(0)
  schemaVersion String?               @default("0001-b")
  updatedAt     DateTime              @updatedAt
  updatedBy     String?

  @@unique([name, revision, active])
}

model RecipeGroup {
  createdAt        DateTime          @default(now())
  createdBy        String
  id               String            @id @default(cuid())
  productionOrders ProductionOrder[]
  recipe           String
  recipes          Recipe[]
  revision         Int?              @default(0)
  scheduleOrders   ScheduleOrder[]
  schemaVersion    String?           @default("0001-alpha")
  updatedAt        DateTime          @updatedAt
  updatedBy        String?

  @@unique([recipe, revision])
}

model ProductionOrder {
  boms            Bom[]
  className       String
  complete        Boolean?                   @default(false)
  createdAt       DateTime                   @default(now())
  createdBy       String
  customer        String?
  endDate         DateTime?
  fg              Item?                      @relation(fields: [fgItemId], references: [id])
  fgItemId        String?
  id              String                     @id @default(cuid())
  inProcess       Boolean?                   @default(false)
  recipe          Recipe?                    @relation(fields: [recipeId], references: [id])
  recipeId        String?
  recipeGroup     RecipeGroup?               @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId   String?
  scheduled       Boolean?                   @default(false)
  scheduleOrder   ScheduleOrder?             @relation(fields: [scheduleOrderId], references: [id])
  scheduleOrderId String?
  schemaVersion   String?                    @default("0001-alpha")
  startDate       DateTime
  status          EnumProductionOrderStatus? @default(Initiated)
  updatedAt       DateTime                   @updatedAt
  updatedBy       DateTime?
}

model ScheduleOrder {
  createdAt                    DateTime                 @default(now())
  createdBy                    String?
  estimatedDistillationTime    Int?
  estimatedFermentationTime    Int?
  estimatedMashingTime         Int?
  estimatedProcessing          Int?
  estimatedTotalProductionTime Int?
  id                           String                   @id @default(cuid())
  productionOrderAllocation    Json
  productionOrders             ProductionOrder[]
  productionSchedules          ProductionSchedule?
  recipeGroup                  RecipeGroup              @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId                String
  recipeName                   String
  scheduleOrderRecipe          Recipe?                  @relation(fields: [scheduleOrderRecipeId], references: [id])
  scheduleOrderRecipeId        String?
  status                       EnumScheduleOrderStatus? @default(Created)
  totalBarrels                 Int?
  totalProofGallons            Int?
  updatedAt                    DateTime                 @updatedAt
  updatedBy                    String?
}

model Item {
  active           Boolean?          @default(false)
  bomsWipItem      Bom[]             @relation(name: "bomsWipItem")
  bomWipItems      Bom[]             @relation(name: "bomItem")
  createdAt        DateTime          @default(now())
  createdBy        String
  id               String            @id @default(cuid())
  itemClass        EnumItemItemClass
  itemDescription  String?
  itemGroup        ItemGroup?        @relation(fields: [itemGroupId], references: [id])
  itemGroupId      String?
  itemName         String
  itemNumber       String
  itemRevision     String
  itemType         String
  productionOrders ProductionOrder[]
  schemaVersion    String?
  updatedAt        DateTime          @updatedAt
  updatedBy        String?
}

model ItemGroup {
  createdAt   DateTime @default(now())
  description String?
  id          String   @id @default(cuid())
  items       Item[]
  name        String
  updatedAt   DateTime @updatedAt
}

model ProductionSchedule {
  actualEnd       DateTime?
  actualStart     DateTime?
  createdAt       DateTime            @default(now())
  createdBy       String?
  duration        Int?
  estimatedEnd    DateTime?
  estimatedStart  DateTime?
  id              String              @id @default(cuid())
  scheduleOrder   ScheduleOrder?      @relation(fields: [scheduleOrderId], references: [id])
  scheduleOrderId String?             @unique
  scheduleQueue   ScheduleOrderQueue? @relation(fields: [scheduleQueueId], references: [id])
  scheduleQueueId String?             @unique
  schemaVersion   String?             @default("0001-alpha")
  updatedAt       DateTime            @updatedAt
  updatedBy       String?
}

enum EnumPhaseParameterSetpointType {
  Boolean
  Numeric
}

enum EnumPhaseParameterStaticName {
  SteamTemperature
  HoldTime
  IngredientName
  IngredientQuantity
  IngredientUnits
}

enum EnumTestParameterTestParamUnits {
  Lbs
  Perc
  Gal
  Bu
  PassFail
}

enum EnumTestParameterTestSetpointType {
  Boolean
  Numerical
}

enum EnumRecipeParameterRecipeParamUnits {
  Lbs
  Gal
  Percentage
  PassFail
  Seconds
  Minutes
  DateTime
  Feet
  Bushels
}

enum EnumRecipeParameterRecipeSetpointType {
  Boolean
  Numeric
}

enum EnumEquipmentPhaseName {
  PreSteam
  Steam
  Hold
  BacksetAdd
  WaterAdd
  AdditiveAdd
  CornAdd
  MaltAdd
  RyeAdd
  WheatAdd
  Drop
  PhCapture
  Cooldown
  Rinse
  HotFlush
  Cip
  Fill
  Run
  FermenterSteam
  CoolerSteam
  DropTubSteam
  DropLineSteam
  DropToMashCooler
  StillStartup
  StillShutdown
  Cut
  Gauge
}

enum EnumOperationName {
  Cook
  FermenterSet
  Fermenter
  Clean
  StillRun
  BlendingTank
  CisternTank
  Barreling
}

enum EnumProcedureName {
  Line1
}

enum EnumUnitProcedureName {
  Mashing01
  Fermentation01
  Distillation01
  Processing01
  Granary01
}

enum EnumProductionOrderStatus {
  Planned
  Committed
  Initiated
  InProgress
  Complete
}

enum EnumScheduleOrderStatus {
  Created
  Scheduled
  InProgress
  Complete
}

enum EnumItemItemClass {
  Inventory
  Assembly
  LotNumberedAssembly
  SerializedAssembly
  LotNumberedInventory
  SerializedInventory
}
