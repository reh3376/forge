datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  createdAt DateTime @default(now())
  firstName String?
  id        String   @id @default(cuid())
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime @updatedAt
  username  String   @unique
}

model PhaseParameter {
  createdAt              DateTime                       @default(now())
  createdBy              String                         @unique
  editedBy               String?                        @unique
  equipmentPhase         EquipmentPhase?                @relation(fields: [equipmentPhaseId], references: [id])
  equipmentPhaseId       String?
  id                     String                         @id @default(cuid())
  itemId                 String?
  recipeId               String?
  schemaVersion          String?                        @default("0001-alpha")
  setpointBooleanValue   Boolean?
  setpointLowerLimit     Float?
  setpointNumericalValue Float?
  setpointType           EnumPhaseParameterSetpointType
  setpointUpperLimit     Float?
  typeDescription        String
  typeName               String
  typeRevision           Int                            @default(0)
  typeUnits              String
  updatedAt              DateTime                       @updatedAt
}

model TestParameter {
  active                   Boolean                            @default(true)
  batch                    String?
  classId                  TestParameter?                     @relation(name: "TestParameterClassIdTestParameterTestParameters", fields: [classId], references: [id])
  classId                  String?
  className                String
  createdAt                DateTime                           @default(now())
  createdBy                String                             @unique
  editedAt                 DateTime?                          @updatedAt
  editedBy                 String?                            @unique
  equipmentPhases          EquipmentPhase[]
  id                       String                             @id @default(auto())
  isClassDef               Boolean?                           @default(false)
  isDefinition             Boolean?                           @default(false)
  itemId                   String
  schemaVersion            String?
  test                     Json?
  testParamDescription     String?
  testParameters           TestParameter[]                    @relation(name: "TestParameterClassIdTestParameterTestParameters")
  testParamName            String
  testParamRevision        String?
  testParamUnits           EnumTestParameterTestParamUnits?
  testPass                 Boolean?
  testResult               String?
  testSetpointBooleanValue Boolean?                           @default(true)
  testSetpointLowerLimit   Float?
  testSetpointType         EnumTestParameterTestSetpointType?
  testSetpointUpperLimit   Float?
  testSetpointValue        Float?

  @@map("TestParameters")
}

model RecipeParameter {
  active                     Boolean                               @default(true)
  batch                      String?
  classId                    RecipeParameter?                      @relation(name: "recipeParameters", fields: [classId], references: [id])
  classId                    String?
  className                  String
  createdAt                  DateTime                              @default(now())
  createdBy                  String                                @unique
  editedAt                   DateTime?                             @updatedAt
  editedBy                   String?                               @unique
  id                         String                                @id @default(cuid())
  isClassDefinition          Boolean?                              @default(false)
  itemId                     String
  recipeParamDescription     String?
  recipeParameters           RecipeParameter[]                     @relation(name: "recipeParameters")
  recipeParamName            String
  recipeParamRevision        String?
  recipeParamUnits           EnumRecipeParameterRecipeParamUnits?
  recipeSetpointBooleanValue Boolean?                              @default(true)
  recipeSetpointLowerLimit   Float?
  recipeSetpointType         EnumRecipeParameterRecipeSetpointType
  recipeSetpointUpperLimit   Float?
  schemaVersion              String?                               @default("0001-alpha")
  sequencerParameters        Json?

  @@map("RecipeParameters")
}

model Instruction {
  active              Boolean?         @default(false)
  createdAt           DateTime         @default(now())
  createdBy           String           @unique
  editedBy            String?          @unique
  equipmentPhase      EquipmentPhase[]
  filePath            String
  id                  String           @id @default(cuid())
  instructionRevision Int              @default(0)
  schemaVersion       String           @default("0001-alpha")
  updatedAt           DateTime         @updatedAt
}

model EquipmentPhase {
  bom                    Bom?             @relation(fields: [bomId], references: [id])
  bomId                  String?
  bomId                  String?
  className              String?
  createdAt              DateTime?        @default(now())
  createdBy              String           @unique
  description            String?
  editedAt               DateTime?        @updatedAt
  editedBy               String?          @unique
  id                     String           @id @default(auto())
  instructions           Instruction[]
  isClassDefinition      Boolean?         @default(false)
  name                   String
  operations             Operation        @relation(fields: [operationId], references: [id])
  operationId            String
  operationSequenceIndex Boolean?
  operationStepSequence  Int?
  phaseParameters        PhaseParameter[]
  revision               Int?             @default(0)
  schemaVersion          String?          @default("0001-b")
  testParameters         TestParameter?   @relation(fields: [testParameterId], references: [id])
  testParameterId        String?

  @@map("equipmentPhases")
}

model Operation {
  active                 Boolean?         @default(true)
  classId                Operation?       @relation(name: "OperationClassIdOperationOperations", fields: [classId], references: [id])
  classId                String?
  createdAt              DateTime?        @default(now())
  createdBy              String           @unique
  description            String
  editedBy               String?          @unique
  globalUuid             String?          @default(uuid())
  id                     String           @id @default(auto())
  isClassDefinition      Boolean?         @default(false)
  name                   String
  operations             Operation[]      @relation(name: "OperationClassIdOperationOperations")
  operationSteps         EquipmentPhase[]
  procedure              Procedure?       @relation(fields: [procedureId], references: [id])
  procedureId            String?
  procedureSequenceIndex Int              @unique @default(0)
  recipes                Recipe[]
  revision               Int              @default(0)
  schemaVersion          String?          @default("0001-b")
  updatedAt              DateTime?        @updatedAt

  @@map("Operations")
}

model Procedure {
  active        Boolean?    @default(true)
  createdAt     DateTime    @default(now())
  createdBy     String      @unique
  description   String?
  id            String      @id @default(cuid())
  name          String?
  operations    Operation[]
  revision      Int?        @default(0)
  schemaVersion String?     @default("0001-b")
  updatedAt     DateTime    @updatedAt
  updatedBy     String?     @unique
}

model Recipe {
  active          Boolean?   @default(true)
  createdAt       DateTime   @default(now())
  createdBy       String
  customer        String?
  id              String     @id @default(cuid())
  item            String?
  itemDescription String?
  mashBill        String?
  operation       Operation? @relation(fields: [operationId], references: [id])
  operationId     String?
  revision        Int?       @default(0)
  schemaVersion   String?    @default("0001-b")
  updatedAt       DateTime   @updatedAt
  updatedBy       DateTime?
}

model Bom {
  batches         Json?
  bomItems        Json
  bomName         String
  bomRevision     Int?             @default(0)
  className       String?
  createdAt       DateTime         @default(now())
  createdBy       String           @unique
  editedAt        DateTime         @updatedAt
  editedBy        String?          @unique
  equipmentPhases EquipmentPhase[]
  id              String           @id @default(auto())
  operationSteps  Json?
  schemaVersion   String?          @default("0001-alpha")
  wipItemId       String?

  @@map("boms")
}

enum EnumPhaseParameterSetpointType {
  Boolean
  Numeric
}

enum EnumTestParameterTestParamUnits {
  Lbs
  Perc
  Gal
  Bu
  PassFail
}

enum EnumTestParameterTestSetpointType {
  Boolean
  Numerical
}

enum EnumRecipeParameterRecipeParamUnits {
  Lbs
  Gal
  Percentage
  PassFail
  Seconds
  Minutes
  DateTime
  Feet
  Bushels
}

enum EnumRecipeParameterRecipeSetpointType {
  Boolean
  Numeric
}
