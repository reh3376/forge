datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  createdAt DateTime @default(now())
  firstName String?
  id        String   @id @default(cuid())
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime @updatedAt
  username  String   @unique
}

model PhaseParameter {
  active                 Boolean?                       @default(false)
  classId                PhaseParameter?                @relation(name: "PhaseParameterClassIdPhaseParameterInstances", fields: [classIdId], references: [id])
  classIdId              String?
  createdAt              DateTime                       @default(now())
  createdBy              String
  description            String
  editedBy               String?
  equipmentPhases        EquipmentPhase[]
  globalId               String?                        @unique @default(cuid())
  id                     String                         @id @default(cuid())
  instances              PhaseParameter[]               @relation(name: "PhaseParameterClassIdPhaseParameterInstances")
  isClassDef             Boolean                        @default(false)
  isStaticParameter      Boolean?                       @default(false)
  itemId                 String?
  name                   String
  recipeId               String?
  revision               Int?                           @default(0)
  schemaVersion          String?                        @default("0001-alpha")
  setpointBooleanValue   Boolean?
  setpointLowerLimit     Float?
  setpointNumericalValue Float?
  setpointType           EnumPhaseParameterSetpointType
  setpointUpperLimit     Float?
  staticName             EnumPhaseParameterStaticName?
  units                  String
  updatedAt              DateTime                       @updatedAt

  @@unique([name, revision, isClassDef])
}

model TestParameter {
  active                   Boolean                            @default(true)
  classId                  TestParameter?                     @relation(name: "TestParameterClassIdTestParameterInstances", fields: [classIdId], references: [id])
  classIdId                String?
  createdAt                DateTime                           @default(now())
  createdBy                String
  description              String?
  equipmentPhases          EquipmentPhase[]
  globalId                 String?                            @default(cuid())
  id                       String                             @id @default(cuid())
  instances                TestParameter[]                    @relation(name: "TestParameterClassIdTestParameterInstances")
  isClassDef               Boolean?                           @default(false)
  itemReceipt              ItemReceipt?                       @relation(fields: [itemReceiptId], references: [id])
  itemReceiptId            String?
  name                     String
  purchaseOrder            PurchaseOrder[]
  schemaVersion            String?
  testDetails              String?
  testedAt                 DateTime?
  testedBy                 String?
  testParamRevision        String?
  testParamUnits           EnumTestParameterTestParamUnits?
  testPass                 Boolean?
  testResult               Json?
  testSetpointBooleanValue Boolean?                           @default(true)
  testSetpointLowerLimit   Float?
  testSetpointType         EnumTestParameterTestSetpointType?
  testSetpointUpperLimit   Float?
  testSetpointValue        Float?
  tooltip                  String?
  updatedAt                DateTime?                          @updatedAt
  updatedBy                String?
}

model RecipeParameter {
  active                     Boolean                               @default(true)
  batch                      String?
  classId                    RecipeParameter?                      @relation(name: "recipeParameters", fields: [classIdId], references: [id])
  classIdId                  String?
  className                  String
  createdAt                  DateTime                              @default(now())
  createdBy                  String
  editedAt                   DateTime?                             @updatedAt
  editedBy                   String?
  globalId                   String?                               @default(cuid())
  id                         String                                @id @default(cuid())
  isClassDefinition          Boolean?                              @default(false)
  itemId                     String
  recipeParamDescription     String?
  recipeParameters           RecipeParameter[]                     @relation(name: "recipeParameters")
  recipeParamName            String
  recipeParamUnits           EnumRecipeParameterRecipeParamUnits?
  recipeSetpointBooleanValue Boolean?                              @default(true)
  recipeSetpointLowerLimit   Float?
  recipeSetpointType         EnumRecipeParameterRecipeSetpointType
  recipeSetpointUpperLimit   Float?
  revision                   Int?                                  @default(0)
  schemaVersion              String?                               @default("0001-alpha")
  sequencerParameters        Json?
}

model Instruction {
  active         Boolean?         @default(false)
  createdAt      DateTime         @default(now())
  createdBy      String
  editedBy       String?
  equipmentPhase EquipmentPhase[]
  filePath       String
  globalId       String?          @unique @default(cuid())
  id             String           @id @default(cuid())
  name           String?
  revision       Int              @default(0)
  schemaVersion  String?          @default("0001-alpha")
  updatedAt      DateTime         @updatedAt

  @@unique([name, revision])
}

model EquipmentPhase {
  active                 Boolean?                   @default(true)
  bomItem                BomItem[]
  classId                EquipmentPhase?            @relation(name: "EquipmentPhaseClassIdEquipmentPhaseInstances", fields: [classIdId], references: [id])
  classIdId              String?
  className              String?
  createdAt              DateTime?                  @default(now())
  createdBy              String
  description            String?
  editedAt               DateTime?                  @updatedAt
  editedBy               String?
  globalId               String?                    @unique @default(cuid())
  id                     String                     @id @default(cuid())
  instances              EquipmentPhase[]           @relation(name: "EquipmentPhaseClassIdEquipmentPhaseInstances")
  instructions           Instruction[]
  isClassDefinition      Boolean?                   @default(false)
  message                String?
  name                   EnumEquipmentPhaseName
  operation              Operation                  @relation(fields: [operationId], references: [id])
  operationId            String
  operationSequenceIndex Int?
  path                   String?
  phaseParameters        PhaseParameter[]
  revision               Int?                       @default(0)
  schemaVersion          String?                    @default("0001-b")
  stepType               EnumEquipmentPhaseStepType @default(NotRequired)
  testParameters         TestParameter[]

  @@unique([name, revision, active, isClassDefinition])
}

model Operation {
  abbreviation            String
  active                  Boolean?                   @default(true)
  auxiliaryPhases         Json?
  classId                 Operation?                 @relation(name: "OperationClassIdOperationInstances", fields: [classIdId], references: [id])
  classIdId               String?
  createdAt               DateTime?                  @default(now())
  createdBy               String
  description             String
  editedBy                String?
  equipmentPhases         EquipmentPhase[]
  fermentationChemistries FermentationChemistry[]
  fermentationDayData     FermentationDayDatum[]
  fermentationSettingData FermentationSettingDatum[]
  globalId                String?                    @default(cuid())
  id                      String                     @id @default(cuid())
  instances               Operation[]                @relation(name: "OperationClassIdOperationInstances")
  isClassDefinition       Boolean?                   @default(false)
  lotId                   String?                    @unique
  name                    EnumOperationName
  path                    String?
  procedureSequenceIndex  Int                        @default(0)
  revision                Int?                       @default(0)
  schemaVersion           String?                    @default("0001-b")
  unitProcedure           UnitProcedure?             @relation(fields: [unitProcedureId], references: [id])
  unitProcedureId         String?
  updatedAt               DateTime?                  @updatedAt

  @@unique([name, revision, active, isClassDefinition])
}

model Procedure {
  active            Boolean?           @default(true)
  classId           Procedure?         @relation(name: "ProcedureClassIdProcedureInstances", fields: [classIdId], references: [id])
  classIdId         String?
  createdAt         DateTime           @default(now())
  createdBy         String
  description       String?
  globalId          String?            @unique @default(cuid())
  id                String             @id @default(cuid())
  instances         Procedure[]        @relation(name: "ProcedureClassIdProcedureInstances")
  isClassDefinition Boolean?
  name              EnumProcedureName?
  revision          Int?               @default(0)
  schemaVersion     String?            @default("0001-b")
  unitProcedures    UnitProcedure[]
  updatedAt         DateTime           @updatedAt
  updatedBy         String?

  @@unique([name, revision, active, isClassDefinition])
}

model Recipe {
  active                        Boolean?                       @default(true)
  createdAt                     DateTime                       @default(now())
  createdBy                     String
  customer                      String
  customerId                    String
  globalId                      String?                        @unique @default(cuid())
  id                            String                         @id @default(cuid())
  itemDescription               String?
  itemId                        String
  lots                          Lot[]
  productionOrders              ProductionOrder[]
  productionOrderUnitProcedures ProductionOrderUnitProcedure[]
  Recipe                        String
  recipeGroup                   RecipeGroup?                   @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId                 String?
  revision                      Int?                           @default(0)
  scheduleOrders                ScheduleOrder[]
  schemaVersion                 String?                        @default("0001-b")
  unitProcedures                UnitProcedure[]
  updatedAt                     DateTime                       @updatedAt
  updatedBy                     String?

  @@unique([itemId, customerId])
}

model Bom {
  bomItem               BomItem[]
  bomName               String
  bomRevision           Int?              @default(0)
  className             String?
  createdAt             DateTime          @default(now())
  createdBy             String
  editedAt              DateTime          @updatedAt
  editedBy              String?
  globalId              String?           @unique @default(cuid())
  id                    String            @id @default(cuid())
  productionOrder       ProductionOrder[]
  schemaVersion         String?           @default("0001-alpha")
  unitProcedure         UnitProcedure[]   @relation(name: "BomsOnUnitProcedure")
  unitProceduresPrimary UnitProcedure[]   @relation(name: "primaryBom")
  wipItem               Item              @relation(fields: [wipItemId], references: [id])
  wipItemId             String
}

model ScheduleOrderQueue {
  createdAt             DateTime      @default(now())
  createdBy             String
  globalId              String?       @unique @default(cuid())
  id                    String        @id @default(cuid())
  nextUnitProcedure     UnitProcedure @relation(fields: [nextUnitProcedureId], references: [id])
  nextUnitProcedureId   String        @unique
  nextUnitProcedureName String
  queueIndex            Int?
  schemaVersion         String?       @default("0001-b")
  updatedAt             DateTime      @updatedAt
  updatedBy             String?

  @@unique([queueIndex, nextUnitProcedureId])
}

model UnitProcedure {
  active                        Boolean?                       @default(true)
  boms                          Bom?                           @relation(name: "BomsOnUnitProcedure", fields: [bomsId], references: [id])
  bomsId                        String?
  classId                       UnitProcedure?                 @relation(name: "UnitProcedureClassIdUnitProcedureInstances", fields: [classIdId], references: [id])
  classIdId                     String?
  createdAt                     DateTime                       @default(now())
  createdBy                     String
  description                   String?
  globalId                      String?                        @unique @default(cuid())
  id                            String                         @id @default(cuid())
  instances                     UnitProcedure[]                @relation(name: "UnitProcedureClassIdUnitProcedureInstances")
  isClassDef                    Boolean?                       @default(false)
  name                          EnumUnitProcedureName
  operations                    Operation[]
  path                          String?
  primaryBom                    Bom?                           @relation(name: "primaryBom", fields: [primaryBomId], references: [id])
  primaryBomId                  String?
  procedure                     Procedure                      @relation(fields: [procedureId], references: [id])
  procedureId                   String
  productionOrderUnitProcedures ProductionOrderUnitProcedure[]
  recipe                        Recipe[]
  revision                      Int?                           @default(0)
  scheduleOrderQueues           ScheduleOrderQueue?
  schemaVersion                 String?                        @default("0001-b")
  updatedAt                     DateTime                       @updatedAt
  updatedBy                     String?

  @@unique([name, revision, active])
}

model RecipeGroup {
  createdAt        DateTime          @default(now())
  createdBy        String
  globalId         String?           @unique @default(cuid())
  id               String            @id @default(cuid())
  productionOrders ProductionOrder[]
  recipe           String
  recipes          Recipe[]
  revision         Int?              @default(0)
  scheduleOrders   ScheduleOrder[]
  schemaVersion    String?           @default("0001-alpha")
  updatedAt        DateTime          @updatedAt
  updatedBy        String?

  @@unique([recipe, revision])
}

model ProductionOrder {
  boms                          Bom                            @relation(fields: [bomsId], references: [id])
  bomsId                        String
  className                     String
  complete                      Boolean?                       @default(false)
  createdAt                     DateTime                       @default(now())
  createdBy                     String
  customer                      String
  endDate                       DateTime?
  fermentationChemistries       FermentationChemistry[]
  fermentationDayData           FermentationDayDatum[]
  globalId                      String?                        @default(cuid())
  id                            String                         @id @default(cuid())
  inProcess                     Boolean?                       @default(false)
  item                          Item                           @relation(fields: [fgItemId], references: [id])
  fgItemId                      String
  lots                          Lot[]
  productionOrderUnitProcedures ProductionOrderUnitProcedure[]
  recipe                        Recipe?                        @relation(fields: [recipeId], references: [id])
  recipeId                      String?
  recipeGroup                   RecipeGroup?                   @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId                 String?
  salesOrder                    SalesOrder                     @relation(fields: [salesOrderId], references: [id])
  salesOrderId                  String                         @unique
  scheduled                     Boolean?                       @default(false)
  scheduleOrder                 ScheduleOrder?                 @relation(fields: [scheduleOrderId], references: [id])
  scheduleOrderId               String?
  schemaVersion                 String?                        @default("0001-alpha")
  startDate                     DateTime
  status                        EnumProductionOrderStatus?     @default(Initiated)
  updatedAt                     DateTime                       @updatedAt
  updatedBy                     DateTime?
}

model ScheduleOrder {
  actualEnd                    DateTime?
  actualStart                  DateTime?
  createdAt                    DateTime                 @default(now())
  createdBy                    String?
  customers                    Json?
  duration                     Decimal?
  durationUnits                String?                  @default("Hours")
  estimatedDistillationTime    Int?
  estimatedEnd                 DateTime?
  estimatedFermentationTime    Int?
  estimatedMashingTime         Int?
  estimatedProcessing          Int?
  estimatedStart               DateTime?
  estimatedTotalProductionTime Int?
  globalId                     String?                  @unique @default(cuid())
  id                           String                   @id @default(cuid())
  productionOrderAllocation    Json
  productionOrders             ProductionOrder[]
  recipeGroup                  RecipeGroup              @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId                String
  recipeName                   String
  scheduleOrderRecipe          Recipe?                  @relation(fields: [scheduleOrderRecipeId], references: [id])
  scheduleOrderRecipeId        String?
  status                       EnumScheduleOrderStatus? @default(Created)
  totalBarrels                 Int?
  totalProofGallons            Int?
  updatedAt                    DateTime                 @updatedAt
  updatedBy                    String?
}

model Item {
  active                        Boolean?                       @default(false)
  bomItems                      BomItem[]
  bomsWipItem                   Bom[]
  createdAt                     DateTime                       @default(now())
  createdBy                     String
  globalId                      String?                        @unique @default(cuid())
  id                            String                         @id @default(cuid())
  itemClass                     EnumItemItemClass
  itemDescription               String?
  itemGroup                     ItemGroup?                     @relation(fields: [itemGroupId], references: [id])
  itemGroupId                   String?
  itemName                      String
  itemNumber                    String
  itemReceipts                  ItemReceipt[]
  itemRevision                  String
  itemType                      String
  lots                          Lot[]
  productionOrders              ProductionOrder[]
  productionOrderUnitProcedures ProductionOrderUnitProcedure[]
  purchaseOrders                PurchaseOrder[]
  schemaVersion                 String?
  updatedAt                     DateTime                       @updatedAt
  updatedBy                     String?
}

model ItemGroup {
  createdAt   DateTime @default(now())
  description String?
  globalId    String?  @unique @default(cuid())
  id          String   @id @default(cuid())
  items       Item[]
  name        String
  updatedAt   DateTime @updatedAt
}

model Account {
  address        String
  createdAt      DateTime        @default(now())
  createdBy      String
  customerCode   String?
  description    String?
  editedBy       String?
  email          String?
  globalId       String?         @unique @default(cuid())
  id             String          @id @default(cuid())
  name           String
  purchaseOrders PurchaseOrder[]
  revision       Int             @default(0)
  salesOrders    SalesOrder[]
  schemaVersion  String?         @default("0001-alpha")
  updatedAt      DateTime        @updatedAt

  @@unique([revision, name])
}

model PurchaseOrder {
  acceptedLots                Lot[]
  account                     Account                         @relation(fields: [accountId], references: [id])
  accountId                   String
  asset                       Asset?                          @relation(fields: [assetId], references: [id])
  assetId                     String?
  className                   String?
  complete                    Boolean?                        @default(false)
  createdAt                   DateTime?                       @default(now())
  createdBy                   String
  editedAt                    DateTime?                       @updatedAt
  editedBy                    String?
  globalId                    String?                         @unique @default(cuid())
  id                          String                          @id @default(cuid())
  item                        Item                            @relation(fields: [itemId], references: [id])
  itemId                      String
  itemReceipts                ItemReceipt[]
  lotsRejected                PurchaseOrder[]                 @relation(name: "lotsRejected")
  name                        String
  orderQuantity               Int
  purchaseOrderGroup          String
  purchaseOrderReceiptDate    DateTime?
  purchaseOrderReceived       Boolean?                        @default(false)
  purchaseOrderRejectedLots   PurchaseOrder?                  @relation(name: "lotsRejected", fields: [purchaseOrderRejectedLotsId], references: [id])
  purchaseOrderRejectedLotsId String?
  qualityTests                TestParameter[]
  receiptStatus               EnumPurchaseOrderReceiptStatus? @default(InitializedNotReceived)
  receivedQuantity            Int?
  revision                    Int?                            @default(0)
  schemaVersion               String?
  units                       String

  @@unique([name, revision, accountId])
}

model SalesOrder {
  account          Account?         @relation(fields: [accountId], references: [id])
  accountId        String?
  createdAt        DateTime         @default(now())
  createdBy        String
  customer         String
  globalId         String?          @unique @default(cuid())
  id               String           @id @default(cuid())
  itemId           String
  orderType        String
  productionOrders ProductionOrder?
  quantity         Int
  revision         Int              @default(0)
  schemaVersion    String?          @default("0001-alpha")
  updatedAt        DateTime         @updatedAt
  updatedBy        String?
}

model Test {
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  createdBy         String
  editedAt          DateTime? @updatedAt
  editedBy          String?
  globalId          String?   @unique @default(cuid())
  id                String    @id @default(cuid())
  isClassDefinition Boolean?  @default(false)
  schemaVersion     String?
  testDescription   String?
  testName          String
  testRevision      Int?      @default(0)
}

model Asset {
  assetPath               String                  @unique
  children                Json?
  createdAt               DateTime                @default(now())
  createdBy               String
  description             String
  fermentationChemistries FermentationChemistry[]
  fermentationDayData     FermentationDayDatum[]
  globalId                String?                 @unique @default(cuid())
  id                      String                  @id @default(cuid())
  mashData                MashDatum[]
  name                    String
  purchaseOrders          PurchaseOrder[]
  revision                Int?                    @default(0)
  schemaVersion           String                  @default("0001-alpha")
  type                    EnumAssetType
  updatedAt               DateTime                @updatedAt
  updatedBy               String?

  @@unique([name, revision])
}

model ItemReceipt {
  createdAt       DateTime               @default(now())
  createdBy       String
  driver          String
  globalId        String?                @unique @default(cuid())
  id              String                 @id @default(cuid())
  item            Item                   @relation(fields: [itemId], references: [id])
  itemId          String
  purchaseOrder   PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?
  quantity        Decimal
  receiptAccepted Boolean?               @default(false)
  schemaVersion   String?                @default("0001-b")
  status          EnumItemReceiptStatus? @default(InProgress)
  supplierLot     String?
  tests           TestParameter[]
  units           String
  updatedAt       DateTime               @updatedAt
  updatedBy       String?
  weighIn         Decimal?
  weighOut        Decimal?
}

model Lot {
  batches                     Batch[]
  createdAt                   DateTime               @default(now())
  createdBy                   String?
  externalId                  String?                @unique
  fermentationChemistries     FermentationChemistry?
  globalId                    String?                @unique @default(cuid())
  id                          String                 @id @default(cuid())
  isRawMaterial               Boolean?               @default(false)
  item                        Item?                  @relation(fields: [itemId], references: [id])
  itemId                      String?
  lotNumber                   String                 @unique
  productionOrder             ProductionOrder?       @relation(fields: [productionOrderId], references: [id])
  productionOrderId           String?
  purchaseOrderAcceptedLots   PurchaseOrder?         @relation(fields: [purchaseOrderAcceptedLotsId], references: [id])
  purchaseOrderAcceptedLotsId String?
  recipe                      Recipe?                @relation(fields: [recipeId], references: [id])
  recipeId                    String?
  schemaVersion               String?                @default("0001-b")
  updatedAt                   DateTime               @updatedAt
}

model BomItem {
  bom             Bom?             @relation(fields: [bomId], references: [id])
  bomId           String?
  consumedAt      DateTime?
  createdAt       DateTime         @default(now())
  createdBy       String
  equipmentPhases EquipmentPhase[]
  id              String           @id @default(cuid())
  item            Item             @relation(fields: [itemId], references: [id])
  itemId          String
  quantity        Decimal
  quantityActual  Decimal?
  units           Unit?            @relation(fields: [unitsId], references: [id])
  unitsId         String?
  updatedAt       DateTime         @updatedAt
  updatedBy       String?
}

model Unit {
  active    Boolean?  @default(true)
  bomItem   BomItem[]
  createdAt DateTime  @default(now())
  globalId  String?   @default(cuid())
  id        String    @id @default(cuid())
  name      String?
  unitType  String?
  updatedAt DateTime  @updatedAt
}

model ProductionOrderUnitProcedure {
  abbreviation      EnumProductionOrderUnitProcedureAbbreviation
  bom               Json?
  createdAt         DateTime                                     @default(now())
  customer          String
  globalId          String?                                      @default(cuid())
  id                String                                       @id @default(cuid())
  name              String
  productionOrder   ProductionOrder?                             @relation(fields: [productionOrderId], references: [id])
  productionOrderId String?
  recipe            Recipe?                                      @relation(fields: [recipeId], references: [id])
  recipeId          String?
  status            EnumProductionOrderUnitProcedureStatus?
  unitProcedure     UnitProcedure?                               @relation(fields: [unitProcedureId], references: [id])
  unitProcedureId   String?
  updatedAt         DateTime                                     @updatedAt
  wipItem           Item?                                        @relation(fields: [itemId], references: [id])
  itemId            String?
}

model FermentationChemistry {
  approved          Boolean?                  @default(false)
  approvedBy        String?
  asset             Asset                     @relation(fields: [assetId], references: [id])
  assetId           String
  batch             Batch                     @relation(fields: [batchId], references: [id])
  batchId           String
  createdAt         DateTime                  @default(now())
  dailyData         FermentationDayDatum[]
  id                String                    @id @default(cuid())
  lot               Lot?                      @relation(fields: [lotId], references: [id])
  lotId             String?                   @unique
  operation         Operation                 @relation(fields: [operationId], references: [id])
  operationId       String
  productionOrder   ProductionOrder?          @relation(fields: [productionOrderId], references: [id])
  productionOrderId String?
  settingData       FermentationSettingDatum? @relation(fields: [settingDataId], references: [id])
  settingDataId     String?                   @unique
  updatedAt         DateTime                  @updatedAt
}

model MashDatum {
  asset           Asset?   @relation(fields: [assetId], references: [id])
  assetId         String?
  backSetPH       Decimal
  backsetVolume   Decimal?
  balling         Decimal
  cornLbs         Decimal?
  createdAt       DateTime @default(now())
  fermenterNumber Int
  id              String   @id @default(cuid())
  loggedBy        String
  lotId           String
  maltLbs         Decimal?
  pH              Decimal
  ryeLbs          Decimal?
  updatedAt       DateTime @updatedAt
  waterVolume     Decimal
  wheatLbs        Decimal?
}

model FermentationSettingDatum {
  acid                    Decimal?
  balling                 Decimal?
  createdAt               DateTime               @default(now())
  dryInches               Decimal?
  fermentationChemistries FermentationChemistry?
  fermenterNumber         Int
  id                      String                 @id @default(cuid())
  loggedBy                String
  lotId                   String
  operation               Operation?             @relation(fields: [operationId], references: [id])
  operationId             String?
  pH                      Decimal?
  setTime                 DateTime
  temperature             Decimal
  updatedAt               DateTime               @updatedAt
  yeastPitchTime          DateTime
}

model FermentationDayDatum {
  acid                    Decimal
  asset                   Asset?                       @relation(fields: [assetId], references: [id])
  assetId                 String?
  balling                 Decimal
  createdAt               DateTime                     @default(now())
  day                     EnumFermentationDayDatumDay? @default(First)
  dryInches               Decimal?
  fermentationChemistry   FermentationChemistry?       @relation(fields: [fermentationChemistryId], references: [id])
  fermentationChemistryId String?
  fermenterNumber         Int
  id                      String                       @id @default(cuid())
  loggedBy                String
  lotId                   String
  operation               Operation                    @relation(fields: [operationId], references: [id])
  operationId             String
  pH                      Decimal
  productionOrder         ProductionOrder              @relation(fields: [productionOrderId], references: [id])
  productionOrderId       String
  temperature             Decimal
  updatedAt               DateTime                     @updatedAt
}

model Batch {
  batchData               Json?
  batchId                 String                  @unique
  children                Batch[]                 @relation(name: "parent")
  createdAt               DateTime                @default(now())
  customers               Json?
  fermentationChemistries FermentationChemistry[]
  id                      String                  @id @default(cuid())
  lot                     Lot?                    @relation(fields: [lotId], references: [id])
  lotId                   String?
  parent                  Batch?                  @relation(name: "parent", fields: [parentId], references: [id])
  parentId                String?
  quantity                Int?
  revision                Int?                    @default(0)
  updatedAt               DateTime                @updatedAt
}

enum EnumPhaseParameterSetpointType {
  Boolean
  Numeric
}

enum EnumPhaseParameterStaticName {
  Temperature
  Time
  Quantity
  Speed
  FlowRate
  SprayballTime
  Level
}

enum EnumTestParameterTestParamUnits {
  Lbs
  Perc
  Gal
  Bu
  PassFail
}

enum EnumTestParameterTestSetpointType {
  Boolean
  Numerical
}

enum EnumRecipeParameterRecipeParamUnits {
  Lbs
  Gal
  Percentage
  PassFail
  Seconds
  Minutes
  DateTime
  Feet
