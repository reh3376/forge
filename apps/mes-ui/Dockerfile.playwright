# Playwright E2E Testing Container
# Builds from workspace root to handle shared packages
FROM mcr.microsoft.com/playwright:v1.40.0-focal

# Set working directory
WORKDIR /app

# Install Node.js 20 (Playwright image comes with older version)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# Copy workspace root package.json files
COPY package*.json ./

# Copy shared package
COPY apps/shared ./apps/shared/

# Build shared package first
WORKDIR /app/apps/shared
RUN npm ci && npm run build

# Go back to workspace root
WORKDIR /app

# Copy frontend package files and configs
COPY apps/mes-ui/package*.json ./apps/mes-ui/
COPY apps/mes-ui/playwright.config.e2e.ts ./apps/mes-ui/
COPY apps/mes-ui/tsconfig.json ./apps/mes-ui/

# Set working directory to frontend
WORKDIR /app/apps/mes-ui

# Install dependencies including Playwright
RUN npm ci

# Install Playwright browsers
RUN npx playwright install --with-deps

# Copy E2E test files and setup
COPY apps/mes-ui/e2e ./e2e/

# Create directories for test outputs
RUN mkdir -p test-results playwright-report

# Set environment for E2E testing
ENV NODE_ENV=test
ENV CI=true

# Run E2E tests by default
CMD ["npm", "run", "test:e2e"] 