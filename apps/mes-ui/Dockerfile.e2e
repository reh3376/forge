# E2E Testing Dockerfile for Next.js Frontend
# Builds from workspace root to handle shared packages
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    libc6-compat \
    curl

# Copy workspace root package.json files
COPY package*.json ./

# Copy shared package
COPY apps/shared ./apps/shared/

# Build shared package first
WORKDIR /app/apps/shared
RUN npm ci && npm run build

# Go back to workspace root
WORKDIR /app

# Copy frontend package files
COPY apps/mes-ui/package*.json ./apps/mes-ui/

# Set working directory to frontend
WORKDIR /app/apps/mes-ui

# Install frontend dependencies
RUN npm ci

# Copy frontend source code and configuration files
COPY apps/mes-ui/app ./app/
COPY apps/mes-ui/public ./public/
COPY apps/mes-ui/components ./components/
COPY apps/mes-ui/lib ./lib/
COPY apps/mes-ui/hooks ./hooks/
COPY apps/mes-ui/stores ./stores/
COPY apps/mes-ui/types ./types/
COPY apps/mes-ui/next.config.ts ./
COPY apps/mes-ui/tailwind.config.ts ./
COPY apps/mes-ui/postcss.config.mjs ./
COPY apps/mes-ui/tsconfig*.json ./
COPY apps/mes-ui/components.json ./
COPY apps/mes-ui/.env* ./

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nextjs -u 1001

# Change ownership of the app directory
RUN chown -R nextjs:nodejs /app
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# Start the application in development mode
CMD ["npm", "run", "dev"] 