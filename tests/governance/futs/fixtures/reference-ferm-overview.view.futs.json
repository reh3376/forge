{
  "spec_version": "0.1.0",
  "spec_kind": "view",
  "identity": {
    "id": "reference-ferm-overview",
    "name": "Fermenter overview",
    "version": "0.1.0",
    "description": "The reference view document: the fermenter overview surface of the plant-floor module's view spec, laid out with every container kind. Not a screen for a plant; the example the runner and the tests are held to."
  },
  "view": {
    "owner_module": "forge-ot",
    "fvts_spec": "tests/governance/fvts/fixtures/reference.fvts.json",
    "surface_id": "ferm.overview",
    "root": {
      "node_id": "screen",
      "container": "switch",
      "layout": {
        "breakpoints": [
          {
            "min_width": 900,
            "show": "wide"
          },
          {
            "min_width": 0,
            "show": "narrow"
          }
        ]
      },
      "children": [
        {
          "node_id": "wide",
          "container": "reflow",
          "layout": {
            "direction": "row",
            "wrap": false,
            "gap": 8
          },
          "children": [
            {
              "node_id": "graphic",
              "container": "fixed",
              "layout": {
                "width": 800,
                "height": 450,
                "scale": "fit"
              },
              "children": [
                {
                  "node_id": "title",
                  "widget": "text-label",
                  "place": {
                    "x": 20,
                    "y": 10,
                    "w": 300,
                    "h": 30
                  },
                  "props": {
                    "text": "Fermenter",
                    "emphasis": "strong"
                  }
                },
                {
                  "node_id": "temp",
                  "widget": "value-display",
                  "place": {
                    "x": 20,
                    "y": 60,
                    "w": 200,
                    "h": 40
                  },
                  "props": {
                    "label": "Temperature"
                  },
                  "bind": {
                    "value": {
                      "point": "ferm.temperature"
                    }
                  }
                },
                {
                  "node_id": "temp_c",
                  "widget": "value-display",
                  "place": {
                    "x": 240,
                    "y": 60,
                    "w": 200,
                    "h": 40
                  },
                  "props": {
                    "label": "Temperature, Celsius",
                    "show_unit": false,
                    "precision": 1
                  },
                  "bind": {
                    "value": {
                      "point": "ferm.temperature",
                      "expression": "(v - 32.0) / 1.8"
                    }
                  }
                },
                {
                  "node_id": "temp_bar",
                  "widget": "level-bar",
                  "place": {
                    "x": 460,
                    "y": 60,
                    "w": 40,
                    "h": 300
                  },
                  "bind": {
                    "value": {
                      "point": "ferm.temperature"
                    }
                  }
                },
                {
                  "node_id": "agitator",
                  "widget": "two-state-symbol",
                  "place": {
                    "x": 20,
                    "y": 140,
                    "w": 120,
                    "h": 120
                  },
                  "props": {
                    "symbol": "motor",
                    "label": "Agitator"
                  },
                  "bind": {
                    "state": {
                      "point": "ferm.agitator_running"
                    }
                  }
                },
                {
                  "node_id": "mode",
                  "widget": "status-indicator",
                  "place": {
                    "x": 160,
                    "y": 140,
                    "w": 200,
                    "h": 40
                  },
                  "props": {
                    "label": "Mode"
                  },
                  "bind": {
                    "state": {
                      "point": "ferm.mode"
                    }
                  }
                }
              ]
            },
            {
              "node_id": "side",
              "container": "reflow",
              "layout": {
                "direction": "column",
                "wrap": false,
                "gap": 8
              },
              "children": [
                {
                  "node_id": "sp",
                  "widget": "input-field",
                  "props": {
                    "label": "Temperature setpoint",
                    "kind": "number"
                  },
                  "bind": {
                    "value": {
                      "point": "ferm.temperature_sp"
                    }
                  },
                  "act": {
                    "submit": "ferm.write_temperature_sp"
                  }
                },
                {
                  "node_id": "alarms",
                  "widget": "alarm-banner",
                  "bind": {
                    "alarms": {
                      "point": "@alarms"
                    }
                  },
                  "act": {
                    "acknowledge": "alarm.acknowledge"
                  }
                }
              ]
            }
          ]
        },
        {
          "node_id": "narrow",
          "container": "reflow",
          "layout": {
            "direction": "column",
            "wrap": false,
            "gap": 6
          },
          "children": [
            {
              "node_id": "n_temp",
              "widget": "value-display",
              "props": {
                "label": "Temperature"
              },
              "bind": {
                "value": {
                  "point": "ferm.temperature"
                }
              }
            },
            {
              "node_id": "n_agitator",
              "widget": "two-state-symbol",
              "props": {
                "symbol": "motor",
                "label": "Agitator"
              },
              "bind": {
                "state": {
                  "point": "ferm.agitator_running"
                }
              }
            },
            {
              "node_id": "n_mode",
              "widget": "status-indicator",
              "props": {
                "label": "Mode"
              },
              "bind": {
                "state": {
                  "point": "ferm.mode"
                }
              }
            },
            {
              "node_id": "n_alarms",
              "widget": "alarm-banner",
              "bind": {
                "alarms": {
                  "point": "@alarms"
                }
              },
              "act": {
                "acknowledge": "alarm.acknowledge"
              }
            }
          ]
        }
      ]
    }
  },
