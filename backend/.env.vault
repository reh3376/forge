#/-------------------.env.vault---------------------/
#/         cloud-agnostic vaulting standard         /
#/   [how it works](https://dotenv.org/env-vault)   /
#/--------------------------------------------------/

# ci
DOTENV_VAULT_CI=""
DOTENV_VAULT_CI_VERSION=14

# codespaces
DOTENV_VAULT_CODESPACES=""
DOTENV_VAULT_CODESPACES_VERSION=4

# development
DOTENV_VAULT_DEVELOPMENT=""
DOTENV_VAULT_DEVELOPMENT_VERSION=23

# staging
DOTENV_VAULT_STAGING=""
DOTENV_VAULT_STAGING_VERSION=14

# production
DOTENV_VAULT_PRODUCTION=""
DOTENV_VAULT_PRODUCTION_VERSION=18

#/----------------settings/metadata-----------------/
DOTENV_VAULT="vlt_f4c9c016b7b60b7b1cba9ed0f5e4b732dcf986ca6798bafe495b35ed42193fbc"
DOTENV_API_URL="https://vault.dotenv.org"
DOTENV_CLI="npx dotenv-vault@latest"
