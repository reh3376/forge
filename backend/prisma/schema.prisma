model ProductionMetric {
  id               String                    @id @default(cuid())
  globalId         String                    @unique @default(cuid())
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  createdBy        String?
  updatedBy        String?
  name             String                    // "yield_pg_per_gu"
  displayName      String                    // "Yield Rate (PG/GU)"
  description      String?
  category         String                    @default("Yield") // Yield, Equipment, Constants
  tags             String[]
  valueNumeric     Float?
  valueString      String?
  unit             String?                   // "PG/GU", "gallons", "lbs"
  sourceType       EnumMetricSourceType      @default(Manual)
  formulaLibraryId String?
  formulaLibrary   FormulaLibrary?           @relation(fields: [formulaLibraryId], references: [id])
  whiskeyType      EnumRecipeWhiskeyType?    // null = all types
  recipeGroupId    String?
  recipeGroup      RecipeGroup?              @relation(fields: [recipeGroupId], references: [id])
  effectiveFrom    DateTime                  @default(now())
  effectiveTo      DateTime?
  isActive         Boolean                   @default(true)
  isSystem         Boolean                   @default(false)
  lastValueChange  DateTime?
  previousValue    Float?

  @@unique([name, whiskeyType])
  @@index([category])
  @@index([isActive])
}

enum EnumMetricSourceType {
  Manual
  Formula
  Sensor
  Derived
}

model FormulaFunction {
  id                 String   @id @default(cuid())
  name               String   @unique // Function name (e.g., "ROUND", "IF")
  syntax             String // Function syntax for display (e.g., "ROUND(value, decimals)")
  description        String? // Help text describing the function
  category           String   @default("Math") // Math, Conditional, Conversion
  exampleUsage       String? // Example showing function usage
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  isSystem           Boolean  @default(false) // true = cannot be deleted by users
  // Implementation configuration
  implementationType String   @default("SYSTEM") // SYSTEM, EXPRESSION, UNIT_CONVERSION
  expression         String? // For EXPRESSION type: the formula (e.g., "x * 3.78541")
  fromUnitId         String? // For UNIT_CONVERSION type: source unit
  toUnitId           String? // For UNIT_CONVERSION type: target unit
  fromUnit           Units?   @relation("FormulaFunctionFromUnit", fields: [fromUnitId], references: [id])
  toUnit             Units?   @relation("FormulaFunctionToUnit", fields: [toUnitId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([implementationType])
}

