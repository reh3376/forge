// ============================================
// Mashing Step Parameter System
// ============================================

// Parameter type for step-specific parameters
enum EnumMashingParameterType {
  Float
  Int
  Boolean
  Text
  Enum
}

// Defines what parameters each step type expects (templates)
model MashingStepParameterDefinition {
  id                  String                              @id @default(cuid())
  globalId            String?                             @unique @default(cuid())
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt
  createdBy           String?
  updatedBy           String?

  // Step type this parameter applies to
  stepType            EnumMashingProtocolStepStepType

  // Parameter identification
  parameterName       String                              // e.g., "targetTemperature", "addRate", "grainQuantity"
  displayName         String                              // Human-readable: "Target Temperature"
  description         String?

  // Type and validation
  parameterType       EnumMashingParameterType            // Float, Int, Boolean, Text, Enum
  unit                String?                             // e.g., "°F", "lbs/min", "gal"
  isRequired          Boolean                             @default(true)
  defaultValue        String?                             // Serialized default value

  // Numeric validation
  validationMin       Float?                              // For numeric validation
  validationMax       Float?

  // Deviation detection threshold (percentage)
  deviationThreshold  Float?                              // e.g., 5 = 5% tolerance

  // Display ordering and categorization
  displayOrder        Int                                 @default(0)
  category            String?                             // e.g., "Temperature", "Material", "Timing"

  // For Enum type parameters
  enumValues          String[]                            // Allowed values for Enum type

  @@unique([stepType, parameterName])
  @@index([stepType])
  @@map("mashing_step_parameter_definitions")
}

// Actual parameter values recorded during step execution
model MashingStepParameterActual {
  id                          String                     @id @default(cuid())
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  // Links
  mashingProtocolStepActual   MashingProtocolStepActual  @relation(fields: [mashingProtocolStepActualId], references: [id])
  mashingProtocolStepActualId String
  stepExecution               StepExecution?             @relation(fields: [stepExecutionId], references: [id])
  stepExecutionId             String?

  // Parameter identity (must match a definition for this step type)
  parameterName               String

  // Values (use appropriate field based on type)
  valuePlanned                Float?                     // Expected value (from protocol)
  valueActual                 Float?                     // Recorded actual for numeric types
  textValueActual             String?                    // For text parameters
  booleanValueActual          Boolean?                   // For boolean parameters

  // Deviation tracking
  deviationPercent            Float?                     // Calculated: |actual - planned| / planned * 100
  isWithinTolerance           Boolean?                   // Based on definition threshold

  // Metadata
  recordedAt                  DateTime                   @default(now())
  recordedBy                  String
  notes                       String?

  @@index([mashingProtocolStepActualId])
  @@index([stepExecutionId])
  @@index([parameterName])
  @@map("mashing_step_parameter_actuals")
}

