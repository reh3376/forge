  status         EnumMessageQueueStatus @default(PENDING)
  attempts       Int                    @default(0)
  maxAttempts    Int                    @default(3)
  lastAttemptAt  DateTime?
  errorMessage   String?
  acknowledgedAt DateTime?
  messageId      String?                @unique
  createdBy      String
  schemaVersion  String?
}

model MqttMessage {
  id                    String                  @id @default(cuid())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  topic                 String
  payload               Json
  qos                   Int?                    @default(0)
  retain                Boolean?                @default(false)
  messageId             String?                 @unique
  brokerConfiguration   UnsBrokerConfiguration? @relation(fields: [brokerConfigurationId], references: [id])
  brokerConfigurationId String?
  expiresAt             DateTime? // TTL field - messages expire after 30 days
  processed             Boolean?                @default(false)
  processingError       String?
  entityType            String? // Mapped entity type (Equipment, Batch, etc.)
  entityId              String? // Mapped entity ID
  tagName               String? // Original MQTT tag name
  numericValue          Float? // Parsed numeric value if applicable
  stringValue           String? // Parsed string value if applicable
  booleanValue          Boolean? // Parsed boolean value if applicable

  @@index([topic])
  @@index([expiresAt])
  @@index([entityType, entityId])
  @@index([tagName])
}

model MqttTagMapping {
  id                    String                  @id @default(cuid())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  createdBy             String
  updatedBy             String?
  tagPattern            String // MQTT topic pattern (supports wildcards)
  entityType            String // Target entity type (Equipment, Batch, RecipeParameter, etc.)
  entityId              String? // Specific entity ID (optional for dynamic mapping)
  entityField           String? // Target field on the entity
  transformationRule    String? // Optional transformation logic (JSON or expression)
  active                Boolean                 @default(true)
  priority              Int                     @default(0) // Higher priority rules are processed first
  description           String?
  brokerConfiguration   UnsBrokerConfiguration? @relation(fields: [brokerConfigurationId], references: [id])
  brokerConfigurationId String?

  @@unique([tagPattern, entityType, entityField])
  @@index([tagPattern])
  @@index([entityType])
  @@index([priority])
}

