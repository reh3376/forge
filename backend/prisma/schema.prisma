model Instruction {
  active         Boolean?         @default(false)
  createdAt      DateTime         @default(now())
  createdBy      String
  editedBy       String?
  equipmentPhase EquipmentPhase[]
  filePath       String
  globalId       String?          @unique @default(cuid())
  id             String           @id @default(cuid())
  name           String?
  revision       Int              @default(0)
  schemaVersion  String?          @default("0001-alpha")
  updatedAt      DateTime         @updatedAt

  @@unique([name, revision])
}

model EquipmentPhase {
  active                 Boolean?                   @default(true)
  bomItem                BomItem[]
  classId                EquipmentPhase?            @relation(name: "EquipmentPhaseClassIdEquipmentPhaseInstances", fields: [classIdId], references: [id])
  classIdId              String?
  className              String?
  createdAt              DateTime?                  @default(now())
  createdBy              String
  description            String?
  editedAt               DateTime?                  @updatedAt
  editedBy               String?
  globalId               String?                    @unique @default(cuid())
  id                     String                     @id @default(cuid())
  instances              EquipmentPhase[]           @relation(name: "EquipmentPhaseClassIdEquipmentPhaseInstances")
  instructions           Instruction[]
  isClassDefinition      Boolean?                   @default(false)
  message                String?
  name                   EnumEquipmentPhaseName
  operation              Operation                  @relation(fields: [operationId], references: [id])
  operationId            String
  operationSequenceIndex Int?
  path                   String?
  phaseParameters        PhaseParameter[]
  revision               Int?                       @default(0)
  schemaVersion          String?                    @default("0001-b")
  stepType               EnumEquipmentPhaseStepType @default(NotRequired)
  testParameters         TestParameter[]
}

model Operation {
  abbreviation           String
  active                 Boolean?          @default(true)
  auxiliaryPhases        Json?
  classId                Operation?        @relation(name: "OperationClassIdOperationInstances", fields: [classIdId], references: [id])
  classIdId              String?
  createdAt              DateTime?         @default(now())
  createdBy              String
  description            String
  editedBy               String?
  equipmentPhases        EquipmentPhase[]
  globalId               String?           @default(cuid())
  id                     String            @id @default(cuid())
  instances              Operation[]       @relation(name: "OperationClassIdOperationInstances")
  isClassDefinition      Boolean?          @default(false)
  lotId                  String?           @unique
  name                   EnumOperationName
  path                   String?
  procedureSequenceIndex Int               @default(0)
  revision               Int?              @default(0)
  schemaVersion          String?           @default("0001-b")
  unitProcedure          UnitProcedure?    @relation(fields: [unitProcedureId], references: [id])
  unitProcedureId        String?
  updatedAt              DateTime?         @updatedAt
  RecipeParameter        RecipeParameter[]
}

model Procedure {
  active            Boolean?           @default(true)
  classId           Procedure?         @relation(name: "ProcedureClassIdProcedureInstances", fields: [classIdId], references: [id])
  classIdId         String?
  createdAt         DateTime           @default(now())
  createdBy         String
  description       String?
  globalId          String?            @unique @default(cuid())
  id                String             @id @default(cuid())
  instances         Procedure[]        @relation(name: "ProcedureClassIdProcedureInstances")
  isClassDefinition Boolean?
  name              EnumProcedureName?
  revision          Int?               @default(0)
  schemaVersion     String?            @default("0001-b")
  unitProcedures    UnitProcedure[]
  updatedAt         DateTime           @updatedAt
  updatedBy         String?

  @@unique([name, revision, active, isClassDefinition])
}

model Recipe {
  Recipe                          String                            @unique
  active                          Boolean?                          @default(true)
  classId                         Recipe?                           @relation(name: "RecipeClassIdRecipeInstances", fields: [classIdId], references: [id])
  classIdId                       String?
  comments                        Comment[]
  cooksPerFerm                    Int?                              @default(3)
  createdAt                       DateTime                          @default(now())
  createdBy                       String
  customer                        Customer                          @relation(fields: [customerId], references: [id])
  customerId                      String
  customerCode                    String?
  globalId                        String?                           @unique @default(cuid())
  id                              String                            @id @default(cuid())
  instances                       Recipe[]                          @relation(name: "RecipeClassIdRecipeInstances")
  isClassDefinition               Boolean?                          @default(true)
  lots                            Lot[]
  mashingProtocol                 MashingProtocol?                  @relation(fields: [mashingProtocolId], references: [id])
  mashingProtocolId               String?
  parameters                      RecipeParameter[]
  productionOrderRecipeInstances  ProductionOrderRecipeInstance[]
  productionOrders                ProductionOrder[]
  recipeBoms                      RecipeBom[]
  recipeGroup                     RecipeGroup?                      @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId                   String?
  revision                        Int?                              @default(1)
  scheduleOrders                  ScheduleOrder[]
  schemaVersion                   String?                           @default("0001-b")
  totalCooks                      Int?
  totalFermenters                 Int?
  unitProcedures                  UnitProcedure[]
  updatedAt                       DateTime                          @updatedAt
  updatedBy                       String?
  whiskeyType                     EnumRecipeWhiskeyType?            @default(RyeBourbon)
  whiskeyTypeId                   String?
  whiskeyTypeRelation             WhiskeyType?                      @relation(fields: [whiskeyTypeId], references: [id])

  // Revision tracking fields
  baseRecipeName                  String?                           // Recipe name without -R## suffix (e.g., "DWL-75C-21R-4M")
  parentRecipeId                  String?                           // Link to previous revision
  parentRecipe                    Recipe?                           @relation(name: "RecipeRevisions", fields: [parentRecipeId], references: [id])
  childRevisions                  Recipe[]                          @relation(name: "RecipeRevisions")

  // Grain character tracking for mashbill
  recipeGrainCharacters           RecipeGrainCharacter[]

  // NEW: Link to SO recipe instances
  scheduleOrderRecipeInstances    ScheduleOrderRecipeInstance[]

  @@unique([baseRecipeName, revision])
  @@index([baseRecipeName])
  @@index([parentRecipeId])
  @@index([whiskeyTypeId])
}

model Bom {
  bomItem               BomItem[]
  bomName               String
  bomRevision           String            @unique
  bomType               String?
  className             String?
  createdAt             DateTime          @default(now())
  createdBy             String
  editedAt              DateTime          @updatedAt
  editedBy              String?
  effectiveEndDate      DateTime?
  effectiveStartDate    DateTime?         @default(now())
  erpId                 String?           @unique
  globalId              String?           @unique @default(cuid())
  id                    String            @id @default(cuid())
  inactive              Boolean?          @default(false)
  item                  Item              @relation(fields: [itemId], references: [id])
  itemId                String
  notes                 String?
  productionOrder       ProductionOrder[]
  schemaVersion         String?           @default("0001-alpha")
  unitProcedure         UnitProcedure[]   @relation(name: "BomsOnUnitProcedure")
  unitProceduresPrimary UnitProcedure[]   @relation(name: "primaryBom")
}

model ScheduleOrderQueue {
  areas         Asset[]
  createdAt     DateTime       @default(now())
  createdBy     String
  globalId      String?        @unique @default(cuid())
  id            String         @id @default(cuid())
  queueIndex    Int?           @unique
  scheduleOrder ScheduleOrder?
  schemaVersion String?        @default("0001-b")
  updatedAt     DateTime       @updatedAt
  updatedBy     String?
}

model UnitProcedure {
  abbreviation  String?
  active        Boolean?              @default(true)
  boms          Bom?                  @relation(name: "BomsOnUnitProcedure", fields: [bomsId], references: [id])
  bomsId        String?
  classId       UnitProcedure?        @relation(name: "UnitProcedureClassIdUnitProcedureInstances", fields: [classIdId], references: [id])
  classIdId     String?
  createdAt     DateTime              @default(now())
  createdBy     String
  description   String?
  globalId      String?               @unique @default(cuid())
  id            String                @id @default(cuid())
  instances     UnitProcedure[]       @relation(name: "UnitProcedureClassIdUnitProcedureInstances")
  isClassDef    Boolean?              @default(false)
  name          EnumUnitProcedureName
  operations    Operation[]
  path          String?
  primaryBom    Bom?                  @relation(name: "primaryBom", fields: [primaryBomId], references: [id])
  primaryBomId  String?
  procedure     Procedure             @relation(fields: [procedureId], references: [id])
  procedureId   String
  recipe        Recipe[]
  revision      Int?                  @default(0)
  schemaVersion String?               @default("0001-b")
  updatedAt     DateTime              @updatedAt
  updatedBy     String?
}

model RecipeGroup {
  createdAt      DateTime        @default(now())
  createdBy      String
  globalId       String?         @unique @default(cuid())
  id             String          @id @default(cuid())
  recipe         String
  recipes        Recipe[]
  revision       Int?            @default(0)
  scheduleOrders     ScheduleOrder[]
  productionMetrics  ProductionMetric[]
  schemaVersion  String?         @default("0001-alpha")
  updatedAt      DateTime        @updatedAt
  updatedBy      String?

  @@unique([recipe, revision])
}

model ProductionOrder {
  bom                            Bom                               @relation(fields: [bomId], references: [id])
  bomId                          String
  className                      String?
  complete                       Boolean?                          @default(false)
  completedQuantity              Decimal?
  containerItem                  Item[]                            @relation(name: "containerItem")
  containerType                  EnumProductionOrderContainerType? @default(LargeBarrel)
  createdAt                      DateTime                          @default(now())
  createdBy                      String
  customer                       Customer                          @relation(fields: [customerId], references: [id])
  customerId                     String
  customerCode                   String?
  endDate                        DateTime?
  finalProof                     Float?
  globalId                       String?                           @default(cuid())
  id                             String                            @id @default(cuid())
  inProcess                      Boolean?                          @default(false)
  item                           Item                              @relation(name: "ItemOnProductionOrders", fields: [fgItemId], references: [id])
  fgItemId                       String
  lots                           Lot[]
  lowerControlLimit              Int?
  millingBinConfiguration        MillingBinConfiguration?          @relation(fields: [millingBinConfigurationId], references: [id])
  millingBinConfigurationId      String?
  name                           String?                           @unique
  productionOrderRecipeInstances ProductionOrderRecipeInstance[]
  quantity                       Int?
  recipe                         Recipe?                           @relation(fields: [recipeId], references: [id])
  recipeId                       String?
  scheduleOrder                  ScheduleOrder?                    @relation(fields: [scheduleOrderId], references: [id])
  scheduleOrderId                String?
  scheduled                      Boolean?                          @default(false)
  schemaVersion                  String?                           @default("0001-alpha")
  startDate                      DateTime?                         @default(now())
  status                         EnumProductionOrderStatus?        @default(Initiated)
  units                          Units?                            @relation(fields: [unitsId], references: [id])
  unitsId                        String?
  updatedAt                      DateTime                          @updatedAt
  updatedBy                      String?
  SalesOrder                     SalesOrder[]
  upperControlLimit              Int?
  // NEW: FIFO allocations from separation
  fifoAllocations                FifoAllocation[]
}

model ScheduleOrder {
  actualEnd                        DateTime?
  actualStart                      DateTime?
  createdAt                        DateTime                      @default(now())
  createdBy                        String?
  customers                        Customer[]
  duration                         Float?
  durationUnits                    String?                       @default("Hours")
  estimatedBarrelingStartTime      DateTime?
  estimatedDistillationDuration    Float?
  estimatedDistillationStartTime   DateTime?
  estimatedEnd                     DateTime?
  estimatedFermentationDuration    Float?
  estimatedFermentationStartTime   DateTime?
  estimatedMashingDuration         Float?
  estimatedMashingStartTime        DateTime?
  estimatedProcessingStartTime     DateTime?
  estimatedStart                   DateTime?
  estimatedTotalProductionDuration Float?
  globalId                         String?                       @unique @default(cuid())
  id                               String                        @id @default(cuid())
  name                             String?                       @unique
  productionOrderAllocation        Json
  productionOrders                 ProductionOrder[]
  recipeGroup                      RecipeGroup                   @relation(fields: [recipeGroupId], references: [id])
  recipeGroupId                    String
  recipeName                       String
  scheduleOrderQueues              ScheduleOrderQueue?           @relation(fields: [scheduleOrderQueueId], references: [id])
  scheduleOrderRecipe              Recipe?                       @relation(fields: [scheduleOrderRecipeId], references: [id])
  scheduleOrderRecipeId            String?
  status                           EnumScheduleOrderStatus?      @default(Created)
  totalBarrels                     Int?
  totalProofGallons                Float?
  // Production execution tracking fields moved from ProductionOrder
  completedCooks                   Int?
  completedFermenters              Int?
  estimatedBarrelsPerFermenter     Float?
  estimatedPGsPerBbl               Float?
  estimatedPGsPerBushel            Float?
  executedCooks                    Int?
  executedFermenters               Int?
  plannedCooks                     Int?
  plannedFermenters                Int?
  totalCooks                       Int?
  totalFermenters                  Int?
  totalGrainWeight                 Float?
  grainPerCook                     Float?                        // Grain per cook for this run (from solver or manual override)
  planningMode                     String?                       @default("auto") // "auto" | "manual"
  // Water load tracking
  totalWaterVolume                 Float?
  loadsLastUpdatedAt               DateTime?
  loadsLastUpdatedBy               String?
  updatedAt                        DateTime                      @updatedAt
  updatedBy                        String?
  scheduleOrderQueueId             String?                       @unique
  schemaVersion                    String?
  // NEW: Link to SO recipe instance for hybrid model
  scheduleOrderRecipeInstance      ScheduleOrderRecipeInstance?
  fermenterAssignments             FermenterAssignment[]
}

model Item {
  active                        Boolean?                   @default(true)
  additiveActuals               AdditiveActual[]
  baseBomItem                   Boolean?                   @default(false)
  batchMaterialConsumptions     BatchMaterialConsumption[]
  bomItems                      BomItem[]
  bomsWipItem                   Bom[]
  createdAt                     DateTime                   @default(now())
  createdBy                     String
  erpId                         String                     @unique
  globalId                      String?                    @unique @default(cuid())
  id                            String                     @id @default(cuid())
  inventories                   Inventory[]
  inventoryLogs                 InventoryLog[]
  inventoryTransfers            InventoryTransfer[]
  itemClass                     String?
  itemDescription               String?
  itemGroup                     String?
  itemName                      String
  itemNumber                    String                     @unique
  itemReceipts                  ItemReceipt[]
  itemRevision                  Int?                       @default(0)
  itemType                      String
  lotContinerItem               Lot?                       @relation(name: "continerItem")
  lots                          Lot[]                      @relation(name: "ItemOnLots")
  productionOrderContainerItems ProductionOrder[]          @relation(name: "containerItem")
  productionOrders              ProductionOrder[]          @relation(name: "ItemOnProductionOrders")
  purchaseOrders                PurchaseOrder[]
  recipeBoms                    RecipeBomItem[]
  salesOrders                   SalesOrder[]
  schemaVersion                 String?
  testParameters                TestParameter[]
  unit                          Unit?                      @relation(fields: [unitId], references: [id])
  unitId                        String?
  units                         Units?                     @relation(fields: [unitsId], references: [id])
  unitsId                       String?
  updatedAt                     DateTime                   @updatedAt
  updatedBy                     String?
  vendor                        Vendor?                    @relation(fields: [vendorId], references: [id])
  vendorId                      String?
  EnzymeConfiguration           EnzymeConfiguration?
}

model ItemGroup {
  createdAt                DateTime                  @default(now())
  description              String?
  globalId                 String?                   @unique @default(cuid())
  id                       String                    @id @default(cuid())
  millingBinConfigurations MillingBinConfiguration[]
  name                     String                    @unique
  unitsItems               Units[]
  updatedAt                DateTime                  @updatedAt
  grainCharacter           GrainCharacter?           @relation(fields: [grainCharacterId], references: [id])
  grainCharacterId         String?

  @@index([grainCharacterId])
}

model Customer {
  address          String
  batches          Batch[]
  createdAt        DateTime          @default(now())
  createdBy        String
  customerCode     String?           @unique
  description      String?
  editedBy         String?
  email            String?
  furnishedLots    Lot[]
  globalId         String?           @unique @default(cuid())
  id               String            @id @default(cuid())
  inventoryLog     InventoryLog?     @relation(fields: [inventoryLogId], references: [id])
  inventoryLogId   String?
  name             String
  phone            String?
  productionOrders ProductionOrder[]
  recipes          Recipe[]
  revision         Int               @default(0)
  salesOrders      SalesOrder[]
  scheduleOrders   ScheduleOrder[]
  schemaVersion    String?           @default("0001-alpha")
  updatedAt        DateTime          @updatedAt

  @@unique([revision, name])
}

model PurchaseOrder {
  acceptedLots                Lot[]
  asset                       Asset?                   @relation(fields: [assetId], references: [id])
  assetId                     String?
  className                   String?
  complete                    Boolean?                 @default(false)
  createdAt                   DateTime?                @default(now())
  createdBy                   String
  erpId                       String                   @unique
  globalId                    String                   @unique @default(cuid())
  id                          String                   @id @default(cuid())
  item                        Item[]
  itemReceipts                ItemReceipt[]
  lineItems                   Json?
  lotsRejected                PurchaseOrder[]          @relation(name: "lotsRejected")
  name                        String
  purchaseOrderReceiptDate    DateTime?
  purchaseOrderReceived       Boolean?                 @default(false)
  purchaseOrderRejectedLots   PurchaseOrder?           @relation(name: "lotsRejected", fields: [purchaseOrderRejectedLotsId], references: [id])
  purchaseOrderRejectedLotsId String?
  qualityTests                TestParameter[]
  receivedQuantity            Int?
  revision                    Int?                     @default(0)
  schemaVersion               String?
  status                      EnumPurchaseOrderStatus? @default(Planned)
  totalOrderQuantity          Int?
  transactionGroup            String?
  updatedAt                   DateTime?                @updatedAt
  updatedBy                   String?
  vendor                      Vendor?                  @relation(fields: [vendorId], references: [id])
  vendorId                    String?

  @@unique([name, revision])
}

model SalesOrder {
  createdAt         DateTime         @default(now())
  createdBy         String
  customer          Customer?        @relation(fields: [customerId], references: [id])
  customerId        String?
  customerCode      String?
  erpId             String?          @unique
  globalId          String           @unique @default(cuid())
  id                String           @id @default(cuid())
  item              Item[]
  lineItems         Json?
  name              String?          @unique
  orderType         String?
  quantity          Int
  requestedShipDate DateTime?
  revision          Int              @default(0)
  schemaVersion     String?          @default("0001-alpha")
  updatedAt         DateTime         @updatedAt
  updatedBy         String?
  productionOrderId String?
  ProductionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
}

model Test {
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  createdBy         String
  editedAt          DateTime? @updatedAt
  editedBy          String?
  globalId          String?   @unique @default(cuid())
  id                String    @id @default(cuid())
  isClassDefinition Boolean?  @default(false)
  schemaVersion     String?
  testDescription   String?
  testName          String
  testRevision      Int?      @default(0)
}

model Asset {
  assetPath                String                    @unique
  assetType                EnumAssetAssetType
  batches                  Batch[]
  children                 Asset[]                   @relation(name: "AssetChildrenAssetParent")
  createdAt                DateTime                  @default(now())
  createdBy                String
  description              String
  globalId                 String?                   @unique @default(cuid())
  id                       String                    @id @default(cuid())
  index                    Int?                      @default(0)
  inventories              Inventory[]
  inventoryLogs            InventoryLog[]
  inventoryTransfersFrom   InventoryTransfer[]       @relation(name: "fromLocation")
  inventoryTransfersTo     InventoryTransfer[]       @relation(name: "inventoryTransfersTo")
  itemReceipts             ItemReceipt[]
  lotProofingTank          Lot[]                     @relation(name: "lotProofingTank")
  lotTankofOrigin          Lot[]                     @relation(name: "lotTankofOrigin")
  lots                     Lot[]                     @relation(name: "fromAsset")
  lotsFilledFrom           Lot[]                     @relation(name: "filledFrom")
  millingBinConfigurations MillingBinConfiguration[]
  name                     String
  operatorShifts           OperatorShift[]
  parent                   Asset?                    @relation(name: "AssetChildrenAssetParent", fields: [parentId], references: [id])
  parentId                 String?
  proofInitial             Float?
  purchaseOrders           PurchaseOrder[]
  revision                 Int?                      @default(0)
  scheduleOrderQueues      ScheduleOrderQueue[]
  schemaVersion            String                    @default("0001-alpha")
  status                   EnumAssetStatus?          @default(InService)
  updatedAt                DateTime                  @updatedAt
  updatedBy                String?

  // S88 Equipment State
  operationalState         EnumEquipmentOperationalState? @default(Available)
  isTrackedUnit            Boolean                        @default(false)
  stateTransitions         EquipmentStateTransition[]
  fermenterAssignments     FermenterAssignment[]

  // S88 Relations
  productionEvents         ProductionEvent[]
  stepExecutions           StepExecution[]

  @@unique([name, revision])
}

model ItemReceipt {
  comments        String?
  createdAt       DateTime               @default(now())
  createdBy       String
  driver          String
  globalId        String?                @unique @default(cuid())
  id              String                 @id @default(cuid())
  inventories     Inventory[]
  item            Item                   @relation(fields: [itemId], references: [id])
  itemId          String
  loadId          Int?                   @default(autoincrement())
  lots            Json?
  purchaseOrder   PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
