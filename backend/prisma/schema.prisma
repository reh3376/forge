// ScheduleOrderRecipeInstance - Central model for tracking combined recipe execution at SO level
model ScheduleOrderRecipeInstance {
  id                              String                          @id @default(cuid())
  globalId                        String?                         @unique @default(cuid())

  // Core relationships
  scheduleOrder                   ScheduleOrder                   @relation(fields: [scheduleOrderId], references: [id])
  scheduleOrderId                 String                          @unique
  recipe                          Recipe                          @relation(fields: [recipeId], references: [id])
  recipeId                        String

  // Status tracking
  status                          EnumRecipeInstanceStatus        @default(Created)
  currentPhase                    EnumProductionPhase?
  separationStarted               Boolean                         @default(false)
  separationCompletedAt           DateTime?

  // Component-based actuals (SO-level)
  recipeBomActuals                RecipeBomActual[]
  recipeParameterActuals          RecipeParameterActual[]

  // Recipe component copies (SO-level)
  mashingProtocols                MashingProtocol[]               @relation("ScheduleOrderMashingProtocols")
  recipeBoms                      RecipeBom[]                     @relation("ScheduleOrderRecipeBoms")
  recipeParameters                RecipeParameter[]               @relation("ScheduleOrderRecipeParameters")
  batches                         Batch[]                         @relation("ScheduleOrderBatches")

  // Separation
  separationEvent                 SeparationEvent?

  // Link to PO-level instances created at separation
  productionOrderRecipeInstances  ProductionOrderRecipeInstance[]

  // Audit fields
  createdAt                       DateTime                        @default(now())
  createdBy                       String
  updatedAt                       DateTime                        @updatedAt
  updatedBy                       String?
  schemaVersion                   String?                         @default("0001-a")
}

// SeparationEvent - Tracks when combined SO execution transitions to individual PO tracking
model SeparationEvent {
  id                              String                        @id @default(cuid())
  globalId                        String?                       @unique @default(cuid())

  // Link to SO recipe instance being separated
  scheduleOrderRecipeInstance     ScheduleOrderRecipeInstance   @relation(fields: [scheduleOrderRecipeInstanceId], references: [id])
  scheduleOrderRecipeInstanceId   String                        @unique

  status                          EnumSeparationStatus          @default(Initiated)

  // Totals at separation
  totalProofGallonsAvailable      Float?
  totalWineGallonsAvailable       Float?
  totalBarrelsExpected            Int?
  totalBarrelsActual              Int?

  // Timeline
  initiatedAt                     DateTime                      @default(now())
  initiatedBy                     String
  completedAt                     DateTime?
  completedBy                     String?

  // FIFO allocations created
  fifoAllocations                 FifoAllocation[]

  createdAt                       DateTime                      @default(now())
  createdBy                       String
  updatedAt                       DateTime                      @updatedAt
  updatedBy                       String?
  schemaVersion                   String?
}

// FifoAllocation - Tracks FIFO assignment of barrels/lots to individual ProductionOrders
model FifoAllocation {
  id                              String                        @id @default(cuid())
  globalId                        String?                       @unique @default(cuid())

  // Part of which separation
  separationEvent                 SeparationEvent               @relation(fields: [separationEventId], references: [id])
  separationEventId               String

  // Allocated to which PO
  productionOrder                 ProductionOrder               @relation(fields: [productionOrderId], references: [id])
  productionOrderId               String

  // FIFO sequencing (based on PO creation order)
  fifoSequence                    Int

  // Allocation details
  quantityRequested               Float                         // PO's requested quantity
  quantityAllocated               Float                         // Actually allocated
  proofGallonsAllocated           Float?
  allocationComplete              Boolean                       @default(false)

  // Lots assigned to this allocation
  lots                            Lot[]

  // Link to PO's recipe instance created at separation
  productionOrderRecipeInstance   ProductionOrderRecipeInstance?

  allocatedAt                     DateTime?
  createdAt                       DateTime                      @default(now())
  createdBy                       String
  updatedAt                       DateTime                      @updatedAt
  updatedBy                       String?
  schemaVersion                   String?
}

