// ============================================
// Formula Library Models
// ============================================

model FormulaLibrary {
  id                String   @id @default(cuid())
  globalId          String   @unique @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String
  updatedBy         String?

  // Formula identification
  name              String   @unique
  description       String?
  category          String?  // "Grain", "Water", "Enzyme", "Custom"
  tags              String[]

  // Expression
  expression        String   // "=grainLoad * 0.7"
  version           Int      @default(1)
  isActive          Boolean  @default(true)

  // Documentation
  documentation     String?
  exampleInputs     Json?
  expectedOutputs   Json?

  // Variable metadata
  requiredVariables String[]
  optionalVariables String[]

  // Relationships
  versions          FormulaLibraryVersion[]
  bomItems          RecipeBomItem[]
  testCases         FormulaTestCase[]
  productionMetrics ProductionMetric[]

  @@index([category])
  @@index([isActive])
  @@index([createdBy])
}

model FormulaLibraryVersion {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  createdBy         String

  formula           FormulaLibrary @relation(fields: [formulaId], references: [id])
  formulaId         String

  version           Int
  expression        String
  description       String?
  changeReason      String?
  snapshot          Json

  @@index([formulaId, version])
}

model FormulaTestCase {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String

  formula           FormulaLibrary @relation(fields: [formulaId], references: [id])
  formulaId         String

  name              String
  inputs            Json     // { grainLoad: 3000, waterLoad: 240 }
  expectedOutput    Float
  tolerance         Float?   @default(0.01)

  // Test execution tracking
  lastRunAt         DateTime?
  lastRunPassed     Boolean?
  lastRunOutput     Float?

  @@index([formulaId])
}

model FormulaExecutionLog {
  id                String   @id @default(cuid())
  executedAt        DateTime @default(now())

  formulaId         String?
  expression        String

  variables         Json
  result            Float?
  executionTimeMs   Int?

  success           Boolean
  errorMessage      String?

  recipeBomItemId   String?
  scheduleOrderId   String?

  @@index([formulaId])
  @@index([executedAt])
  @@index([recipeBomItemId])
}

// Formula configuration - database-driven variables and functions
model FormulaVariable {
  id           String   @id @default(cuid())
  name         String   @unique // Variable name used in formulas (e.g., "grainLoad")
  displayName  String // User-friendly display name (e.g., "Grain Load")
  description  String? // Help text describing the variable
  type         String   @default("number") // number, string, boolean
  defaultValue String? // Default value for preview/testing
  category     String   @default("General") // General, Water, Conversion
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  isSystem     Boolean  @default(false) // true = cannot be deleted by users
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

