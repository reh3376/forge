datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  createdAt DateTime   @default(now())
  firstName String?
  id        String     @id @default(cuid())
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime   @updatedAt
  username  String     @unique
  auditLogs AuditLog[]
}

// AuditLog model for tracking configuration changes
model AuditLog {
  id         String      @id @default(cuid())
  globalId   String      @unique @default(cuid())
  entityType String // The type of entity being modified (e.g., "User", "Configuration")
  entityId   String // The ID of the entity being modified
  action     AuditAction // The type of change (CREATE/UPDATE/DELETE)
  oldValues  Json? // Previous values before change (null for CREATE)
  newValues  Json? // New values after change (null for DELETE)
  userId     String? // Who made the change (null for system-triggered operations)
  user       User?       @relation(fields: [userId], references: [id])
  ipAddress  String? // IP address of the request
  userAgent  String? // Browser/client information
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Indexes for performance optimization
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model PhaseParameter {
  active                 Boolean?                       @default(false)
  classId                PhaseParameter?                @relation(name: "PhaseParameterClassIdPhaseParameterInstances", fields: [classIdId], references: [id])
  classIdId              String?
  createdAt              DateTime                       @default(now())
  createdBy              String
  description            String
  editedBy               String?
  equipmentPhases        EquipmentPhase[]
  globalId               String?                        @unique @default(cuid())
  id                     String                         @id @default(cuid())
  instances              PhaseParameter[]               @relation(name: "PhaseParameterClassIdPhaseParameterInstances")
  isClassDef             Boolean                        @default(false)
  isStaticParameter      Boolean?                       @default(false)
  itemId                 String?
  name                   String
  recipeId               String?
  revision               Int?                           @default(0)
  schemaVersion          String?                        @default("0001-alpha")
  setpointBooleanValue   Boolean?
  setpointLowerLimit     Float?
  setpointNumericalValue Float?
  setpointType           EnumPhaseParameterSetpointType
  setpointUpperLimit     Float?
  staticName             EnumPhaseParameterStaticName?
  stringValue            String?
  units                  String
  updatedAt              DateTime                       @updatedAt
}

model TestParameter {
  active                   Boolean                            @default(true)
  schemaVersion            String?
  testSetpointValue        Float?
  testParamUnits           String
  testSetpointUpperLimit   Float?
  testParamRevision        String?
  testSetpointLowerLimit   Float?
  testResult               Float?
  testPass                 Boolean?                           @default(false)
  testSetpointBooleanValue Boolean?
  testedAt                 DateTime?
  createdBy                String
  testSetpointType         EnumTestParameterTestSetpointType?
  testedBy                 String?
  tooltip                  String?
  name                     String
  updatedAt                DateTime?                          @updatedAt
  updatedBy                String?
  testDetails              String?
  equipmentPhases          EquipmentPhase[]
  isClassDef               Boolean?                           @default(false)
  classId                  TestParameter?                     @relation(name: "TestParameterClassIdTestParameterInstances", fields: [classIdId], references: [id])
  classIdId                String?
  createdAt                DateTime                           @default(now())
  description              String?
  globalId                 String?                            @default(cuid())
  id                       String                             @id @default(cuid())
  instances                TestParameter[]                    @relation(name: "TestParameterClassIdTestParameterInstances")
  item                     Item[]
  itemGroup                String?
  itemReceipt              ItemReceipt?                       @relation(fields: [itemReceiptId], references: [id])
  itemReceiptId            String?
  // PurchaseOrder            PurchaseOrder?                     @relation(fields: [purchaseOrderId], references: [id])
  // purchaseOrderId          String?
  purchaseOrder            PurchaseOrder[]
  required                 Boolean?                           @default(true)
}

