  phase                 EnumProductionPhase?
  operationName         String?
  stepIndex             Int?
  branchIndex           Int?

  asset                 Asset?                      @relation(fields: [assetId], references: [id])
  assetId               String?

  previousState         String?
  newState              String?

  parameterName         String?
  previousValue         Float?
  newValue              Float?
  units                 String?

  conditionId           String?
  originalCondition     Json?
  overrideValue         Json?

  occurredAt            DateTime                    @default(now())

  acknowledgedAt        DateTime?
  acknowledgedBy        String?
  resolvedAt            DateTime?
  resolvedBy            String?

  initiatedBy           String?

  metadata              Json?

  createdAt             DateTime                    @default(now())
  createdBy             String
  schemaVersion         String?

  @@index([batchId])
  @@index([eventType])
  @@index([eventCategory])
  @@index([occurredAt])
  @@index([severity])
}

model StepExecution {
  id                        String                   @id @default(cuid())
  globalId                  String?                  @unique @default(cuid())

  batch                     Batch                    @relation(fields: [batchId], references: [id])
  batchId                   String

  mashingProtocolStepId     String?
  phaseProtocolStepId       String?

  phase                     EnumProductionPhase
  operationName             String?
  stepIndex                 Int
  branchIndex               Int                      @default(0)
  stepName                  String

  state                     EnumS88StepState         @default(Idle)
  previousState             EnumS88StepState?

  allocatedAsset            Asset?                   @relation(fields: [allocatedAssetId], references: [id])
  allocatedAssetId          String?
  equipmentMode             String?

  plannedStartTime          DateTime?
  plannedEndTime            DateTime?
  plannedDuration           Int?

  actualStartTime           DateTime?
  actualEndTime             DateTime?
  actualDuration            Int?

  entryConditionMet         Boolean                  @default(false)
  entryConditionMetAt       DateTime?
  exitConditionMet          Boolean                  @default(false)
  exitConditionMetAt        DateTime?

  conditionOverrides        Json?

  startedBy                 String?
  completedBy               String?
  pausedBy                  String?
  pauseReason               String?
  heldBy                    String?
  holdReason                String?
  abortedBy                 String?
  abortReason               String?

  stateHistory              Json?

  createdAt                 DateTime                 @default(now())
  createdBy                 String
  updatedAt                 DateTime                 @updatedAt
  schemaVersion             String?

  // Back-reference to MashingProtocolStepActual
  mashingProtocolStepActual MashingProtocolStepActual?

  // Step parameter actuals
  parameterActuals          MashingStepParameterActual[]

  @@index([batchId])
  @@index([state])
  @@index([phase, stepIndex])
  @@unique([batchId, phase, branchIndex, stepIndex])
}

