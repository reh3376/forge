datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider                  = "prisma-erd-generator"
  puppeteerConfig           = "./puppeteerConfig.json"
  output                    = "./ERD.svg" // file format and location
  theme                     = "forest" // default | forest | dark | neutral
  includeRelationFromFields = true // optional: show FK fields
  tableOnly                 = false
  ignoreEnums               = false
}

generator erd-md {
  provider = "prisma-erd-generator"
  output   = "./ERD.md"
}

model User {
  createdAt DateTime   @default(now())
  firstName String?
  id        String     @id @default(cuid())
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime   @updatedAt
  username  String     @unique
  auditLogs AuditLog[]
}

// AuditLog model for tracking configuration changes
model AuditLog {
  id         String      @id @default(cuid())
  globalId   String      @unique @default(cuid())
  entityType String // The type of entity being modified (e.g., "User", "Configuration")
  entityId   String // The ID of the entity being modified
  action     AuditAction // The type of change (CREATE/UPDATE/DELETE)
  oldValues  Json? // Previous values before change (null for CREATE)
  newValues  Json? // New values after change (null for DELETE)
  userId     String // Who made the change
  user       User        @relation(fields: [userId], references: [id])
  ipAddress  String? // IP address of the request
  userAgent  String? // Browser/client information
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Indexes for performance optimization
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

