# Dockerfile optimized for Raspberry Pi (ARM architecture)
# Uses Node.js 18 LTS for better compatibility with older ARM kernels

# Define the Node.js version - using 18 LTS for Raspberry Pi 4 compatibility
ARG NODE_VERSION=18-bullseye

# multi-stage: base (build)
FROM node:${NODE_VERSION} AS base

# Add New Relic Env Vars
ENV NEW_RELIC_NO_CONFIG_FILE=true
ENV NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
ENV NEW_RELIC_LOG=stdout

# create directory where the application will be built
WORKDIR /app

# copy over the dependency manifests, both the package.json
# and the package-lock.json are copied over
COPY package*.json ./

# installs packages and their dependencies
RUN npm install

# copy over the prisma schema
COPY prisma/schema.prisma ./prisma/

# generate the prisma client based on the schema
RUN npm run prisma:generate

# copy over the code base
COPY . .

# create the bundle of the application
RUN npm run build

# multi-stage: production (runtime)
FROM node:${NODE_VERSION}-slim AS production

# create arguments of builds time variables
ARG user=node
ARG group=${user}
ARG uid=1000
ARG gid=$uid

# [temporary] work around to be able to run prisma
# Copy openssl from base image to avoid apt-get issues on Raspberry Pi
COPY --from=base /usr/bin/openssl /usr/bin/openssl
COPY --from=base /usr/lib/arm-linux-gnueabihf/libssl.so.* /usr/lib/arm-linux-gnueabihf/
COPY --from=base /usr/lib/arm-linux-gnueabihf/libcrypto.so.* /usr/lib/arm-linux-gnueabihf/

# create directory where the application will be executed from
WORKDIR /app

# copy over the bundled code from the build stage
COPY --from=base /app/node_modules/ ./node_modules
COPY --from=base /app/package.json ./package.json
COPY --from=base /app/dist ./dist
COPY --from=base /app/prisma ./prisma
COPY --from=base /app/scripts ./scripts
COPY --from=base /app/src ./src
COPY --from=base /app/tsconfig* ./

# change ownership of the workspace directory
RUN chown -R ${uid}:${gid} /app/

# get rid of the development dependencies
RUN npm install --production

# set user to the non-privileged user
USER ${user}

# expose a specific port on the docker container
ENV PORT=3000
EXPOSE ${PORT}

# start the server using the previously built application
CMD [ "node", "./dist/main.js" ]
