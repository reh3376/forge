# Forge Platform — Multi-stage Dockerfile
# Build: docker build -f deploy/docker/Dockerfile.forge -t forge:dev .
# Run:   docker run -p 8000:8000 -p 50051:50051 forge:dev
#
# Every Python version comes from uv.lock (FB-096): the image is built with `uv sync --locked`,
# which fails when pyproject.toml and the lock disagree. The root .dockerignore keeps the build
# context to the files copied below.

# ---- Stage 1: Builder ----
FROM python:3.12-slim AS builder

# Install uv (standalone binary — no pip needed); the 0.9 line wrote the committed lock
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

WORKDIR /app
# Use the image's Python 3.12 (never download one) and copy, not hardlink, out of the cache mount
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy

# Dependencies first, from the manifest and the lock alone, so this layer is cached until one of
# them changes; the project itself is installed after the source is copied. The ot extra carries
# the OT module the hub hosts (asyncua, aiomqtt); dev tooling stays out of the image.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --extra ot

# Application source and the project itself (editable, into the same /app/.venv)
COPY README.md ./
COPY src/ ./src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra ot


# ---- Stage 2: Runtime ----
FROM python:3.12-slim AS runtime

# Runtime dependencies (pg_isready for health checks, curl for debugging)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       postgresql-client \
       curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the virtual environment from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY --from=builder /app/pyproject.toml /app/pyproject.toml

# Ensure venv python is on PATH
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src:$PYTHONPATH"
ENV PYTHONUNBUFFERED=1

# Default ports
EXPOSE 8000 50051

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -fs http://localhost:8000/healthz || exit 1

# Default command: run the Hub API
CMD ["uvicorn", "forge.api.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--log-level", "info"]
