```

### **Pattern 3: Architecture Exploration**
```typescript
// 1. SYSTEM UNDERSTANDING
// Get comprehensive system view
const systemGraph = mcp_graphiti-memory_search_memory_nodes("system architecture")
const codePatterns = mcp_qdrant_qdrant-find("architectural patterns in codebase")

// Query database schema
const schema = mcp_neo4j-cypher_execute_query(`
  MATCH (n:Table)-[r:REFERENCES]->(m:Table)
  RETURN n.name, r.type, m.name
`)

// Get current data relationships
const dataFlow = mcp-graphql-mes.query(`
  query SystemOverview {
    __schema {
      types {
        name
        fields {
          name
          type { name }
        }
      }
    }
  }
`)

// 2. PATTERN DOCUMENTATION
// Document architectural insights
mcp_graphiti-memory_add_memory({
  name: "System Architecture Analysis",
  episode_body: JSON.stringify({
    database_schema: "key relationships and constraints",
    api_structure: "GraphQL schema patterns",
    component_hierarchy: "UI component relationships",
    data_flow: "how data moves through system"
  }),
  source: "json"
})
```

### **Pattern 4: UI Testing & Validation**
```typescript
// 1. TEST PLANNING PHASE
// Get current task and testing requirements
const currentTask = mcp_taskmaster-ai_next_task()
const testingKnowledge = mcp_graphiti-memory_search_memory_facts("UI testing patterns")
const similarTestCases = mcp_qdrant_qdrant-find("end-to-end testing scenarios")

// 2. AUTOMATED UI TESTING
// Navigate and validate UI components
playwright.goto("http://localhost:3000/recipe-management")
playwright.click("[data-testid='create-recipe-button']")
playwright.fill("[data-testid='recipe-name-input']", "Test Recipe")
playwright.click("[data-testid='save-recipe-button']")

// Validate real-time data integration
const recipeData = postgres-mes-local.query("SELECT * FROM recipes WHERE name = 'Test Recipe'")
playwright.waitForSelector(`[data-testid='recipe-${recipeData[0].id}']`)

// 3. CROSS-SYSTEM VALIDATION
// Verify UI state matches database state
const uiState = playwright.evaluate("() => window.__REDUX_STATE__")
const dbState = postgres-mes-local.query("SELECT * FROM production_orders WHERE recipe_id = ?", [recipeData[0].id])

// Document test results and patterns
mcp_graphiti-memory_add_memory({
  name: "UI Test Validation",
  episode_body: JSON.stringify({
    test_scenario: "Recipe creation workflow",
    ui_interactions: ["navigation", "form_filling", "submission"],
    data_validation: "database consistency verified",
    performance_metrics: "load times and responsiveness",
    edge_cases_tested: ["validation errors", "network failures"]
  }),
  source: "json"
})

// Store reusable test patterns
mcp_qdrant_qdrant-store({
  information: "Test pattern: Recipe management workflow validated via Playwright with database verification",
  metadata: { 
    type: "test_pattern",
    component: "RecipeManagement",
    test_type: "end_to_end",
    validation_level: "full_stack"
  }
})

// 4. REGRESSION TESTING
// Run existing test suite and compare results
const testResults = playwright.runTestSuite("recipe-management.spec.ts")
const historicalResults = mcp_qdrant_qdrant-find("previous test results for recipe management")

// Update task with testing insights
mcp_taskmaster-ai_update_subtask({
  id: "current_subtask",
  prompt: `UI Testing completed:
    - All user flows validated
    - Database consistency verified
    - Performance benchmarks met
    - Regression tests passed: ${testResults.passed}/${testResults.total}`
})
```

