// Query system state for current data
const systemState = mcp_neo4j-cypher_execute_query("MATCH (n) WHERE n.status = 'error' RETURN n")
const errorLogs = postgres-mes-local.query("SELECT * FROM logs WHERE level = 'ERROR' ORDER BY timestamp DESC LIMIT 50")

// 2. INVESTIGATION TRACKING
// Document investigation process
mcp_graphiti-memory_add_memory({
  name: "Bug Investigation: [Bug Title]",
  episode_body: `
    Symptoms: [observed behavior]
    Investigation steps: [what was checked]
    Root cause: [technical explanation]
    Fix applied: [solution implemented]
  `
})

// 3. KNOWLEDGE PRESERVATION
// Store solution for future reference
mcp_qdrant_qdrant-store({
  information: "Bug fix: [problem] caused by [root cause] fixed by [solution]",
  metadata: { 
