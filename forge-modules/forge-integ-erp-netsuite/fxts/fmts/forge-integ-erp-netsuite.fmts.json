{
  "spec_version": "2.0.0",
  "module_identity": {
    "module_id": "forge-integ-erp-netsuite",
    "name": "Forge NetSuite ERP Integration Adapter",
    "alias": "netsuite",
    "version": "0.1.0",
    "kind": "integration",
    "function": "erp",
    "language": "python",
    "source_paths": [
      "forge-modules/forge-integ-erp-netsuite/src/python/forge_integ_erp_netsuite"
    ]
  },
  "hub_link": {
    "protocol": "grpc",
    "service": "forge.v1.AdapterService"
  },
  "transport": {
    "process_control_writes": false,
    "business_write_backs": false,
    "data_classes": [
      "raw",
      "historical",
      "status",
      "config"
    ]
  },
  "integration": {
    "product": "NetSuite",
    "supported_versions": [
      "set at the installation"
    ],
    "interfaces": [
      "amqp",
      "graphql",
      "rest"
    ],
    "direction": "read",
    "site_owner": "set at the installation",
    "credential": "netsuite-api"
  },
  "references": {
    "facts": {
      "path": "forge-modules/forge-integ-erp-netsuite/fxts/facts/forge-integ-erp-netsuite.facts.json",
      "adapter_id": "forge-integ-erp-netsuite"
    },
    "manifest": "forge-modules/forge-integ-erp-netsuite/src/python/forge_integ_erp_netsuite/manifest.json"
  },
  "baseline": {
    "M-1": "met",
    "M-2": "met",
    "M-3": "met",
    "M-4": "met",
    "M-5": "met",
    "M-6": "met",
    "M-7": "met",
    "M-8": "met",
    "M-9": "met",
    "M-10": "waived",
    "M-11": "met",
    "M-12": "waived",
    "M-13": "waived",
    "M-14": "waived",
    "M-15": "not_applicable",
    "M-16": "not_applicable"
  },
  "waivers": [
    {
      "requirement": "M-10",
      "reason": "No module ships a roles file yet: the roles file has no FxTS spec to be written against, and the hub still uses its own flat roles.",
      "backlog_item": "FB-141"
    },
    {
      "requirement": "M-12",
      "reason": "The record id rule of the transport contract (T-5) is not built: records carry an id the adapter makes, and the hub does not yet keep each id once.",
      "backlog_item": "FB-164"
    },
    {
      "requirement": "M-13",
      "reason": "Store and forward is not part of the module SDK yet (T-6): the module does not buffer what it cannot deliver.",
      "backlog_item": "FB-164"
    },
    {
      "requirement": "M-14",
      "reason": "The goodbye and the last will of the transport contract (T-8) are not built: the hub learns of a shutdown only when calls stop.",
      "backlog_item": "FB-164"
    }
  ],
  "time_contract": {
    "hub": {
      "exchange": "four-timestamp",
      "fail_closed": true
    },
    "plant_floor_devices": "none",
    "databases": [
      {
        "name": "mod_erpi",
        "owner": "hub",
        "engine": "PostgreSQL",
        "access": "read-write",
        "credential": "forge-issued",
        "written_time_source": "module-clock",
        "fail_closed": true
      }
    ],
    "third_party_systems": [
      {
        "name": "netsuite",
        "interface": "amqp+rest+graphql",
        "clock_read_method": "http-date-header",
        "tolerance_class": "it-lan",
        "clock_probe_interval_seconds": 30,
        "offset_reported": true,
        "fail_closed": true
      }
    ]
  },
  "user_interface": {
    "ships_ui_code": false,
    "screens": false
  },
  "scaffold": {
    "template": "python-adapter"
  },
  "metadata": {
    "hosting": "hub-hosted Python adapter today",
    "state": "An integration module for one named product: it connects Forge to a NetSuite ERP (owner, 2026-11-18). Named forge-integ-<function>-<product> (A-17). It is the hand-written forerunner of what the integration builder will let an installation build (D-13).",
    "time_contract_state": "Nothing reads the ERP's clock yet: the third-party entry is the contract the module is to be built to (FB-139). The hub database mod_erpi holds the ERP-side data; every time the module writes there comes from its own governed clock. M-4 to M-7 are run by the conformance kit through the Python transport, against a reference hub."
  },
