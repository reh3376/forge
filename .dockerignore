# Build context for deploy/docker/Dockerfile.forge: only what it copies (FB-096). Without this the
# context carried .git, .venv and the interim MES bridge's node_modules (well over a gigabyte).
*
!pyproject.toml
!uv.lock
!README.md
!forge-core/
forge-core/*
!forge-core/src/
forge-core/src/**/__pycache__/
!forge-core/contract/
!forge-hub/
forge-hub/*
!forge-hub/src/
forge-hub/src/**/__pycache__/
!forge-hub/fxts/
!forge-modules/
forge-modules/forge-mes/bridge/
forge-modules/**/__pycache__/
forge-modules/*/tests/
forge-modules/*/docs/
# The init container's entrypoint, built into the image (FB-312)
!deploy/
deploy/*
!deploy/docker/
deploy/docker/*
!deploy/docker/init-entrypoint.sh
