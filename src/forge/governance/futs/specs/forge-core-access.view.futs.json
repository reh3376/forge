{
  "spec_version": "0.2.0",
  "spec_kind": "view",
  "identity": {
    "id": "forge-core-access",
    "name": "Users and roles",
    "version": "0.1.0",
    "description": "Who may do what on this hub: users, roles and the assignments between them. Read-only until the role model is built (FB-075). One of the hub's four standard screens."
  },
  "view": {
    "owner_module": "forge-core",
    "fvts_spec": "src/forge/governance/fvts/specs/forge-core.fvts.json",
    "surface_id": "hub.access",
    "root": {
      "node_id": "screen",
      "container": "reflow",
      "layout": {
        "direction": "column",
        "wrap": false,
        "gap": 12
      },
      "children": [
        {
          "node_id": "title",
          "widget": "text-label",
          "props": {
            "text": "Users and roles",
            "emphasis": "strong"
          }
        },
        {
          "node_id": "hint",
          "widget": "text-label",
          "props": {
            "text": "Roles are scoped: an assignment always says where it applies. Assignments made at a hub above are inherited and are not edited here.",
            "emphasis": "muted"
          }
        },
        {
          "node_id": "users",
          "widget": "data-table",
          "props": {
            "title": "Users",
            "columns": "user_id,display_name,identity_method,active,last_sign_in_at",
            "page_size": 25
          },
          "bind": {
            "rows": {
              "object": "hub.user"
            }
          }
        },
        {
          "node_id": "roles",
          "widget": "data-table",
          "props": {
            "title": "Roles",
            "columns": "role_id,module,scopes,inherits",
            "page_size": 25
          },
          "bind": {
            "rows": {
              "object": "hub.role"
            }
          }
        },
        {
          "node_id": "assignments",
          "widget": "data-table",
          "props": {
            "title": "Role assignments",
            "columns": "user_id,role_id,applies_to,assigned_by,assigned_at,source_hub",
            "page_size": 25
          },
          "bind": {
            "rows": {
              "object": "hub.assignment"
            }
          }
        }
      ]
    }
  },
