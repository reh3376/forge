{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge://schemas/forge-hub/Role/v1",
  "title": "Role",
  "description": "One role: a named set of scopes, shipped by a module as data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role_id",
    "module",
    "scopes"
  ],
  "properties": {
    "role_id": {
      "type": "string",
      "description": "Its id."
    },
    "module": {
      "type": "string",
      "description": "The module that ships it."
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The scopes it grants, each domain:resource:action."
    },
    "inherits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The roles it includes."
    }
  }
}
