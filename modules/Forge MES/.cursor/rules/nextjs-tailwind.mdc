## **Authentication Integration**

### **Azure MSAL Integration**
```typescript
// ✅ DO: Manufacturing role-based access
export function useManufacturingAuth() {
  const { user, isAuthenticated } = useAuth();
  
  const hasRole = useCallback((role: ManufacturingRole) => {
    return user?.roles?.includes(role) ?? false;
  }, [user]);
  
  const canAccessEquipment = useCallback((equipmentId: string) => {
    return hasRole('PRODUCTION_MANAGER') || 
           hasRole('OPERATOR') || 
           user?.assignedEquipment?.includes(equipmentId);
  }, [user, hasRole]);
  
  return { hasRole, canAccessEquipment, user, isAuthenticated };
}
```

## **Performance Optimization**

### **Manufacturing Data Optimization**
```typescript
// ✅ DO: Optimize for real-time manufacturing data
export const ProductionDashboard = memo(function ProductionDashboard() {
  const { data: telemetry } = useBatchTelemetry(batchId);
  
  // Throttle real-time updates to prevent UI lag
  const throttledTelemetry = useThrottle(telemetry, 1000);
  
  return (
    <div className="grid gap-4">
      <Suspense fallback={<ChartSkeleton />}>
        <TelemetryChart data={throttledTelemetry} />
      </Suspense>
      <Suspense fallback={<TableSkeleton />}>
        <BatchDataTable />
      </Suspense>
    </div>
  );
});

// ✅ DO: Virtualization for large datasets
export function RecipeDataTable({ recipes }: { recipes: Recipe[] }) {
  const virtualizer = useVirtualizer({
    count: recipes.length,
    getScrollElement: () => parentRef.current,
    estimateSize: () => 50,
  });
  
  return (
    <div ref={parentRef} className="h-[400px] overflow-auto">
      <div style={{ height: `${virtualizer.getTotalSize()}px` }}>
        {virtualizer.getVirtualItems().map((virtualItem) => (
          <RecipeRow
            key={virtualItem.key}
            recipe={recipes[virtualItem.index]}
            style={{
              position: 'absolute',
              top: 0,
              left: 0,
              width: '100%',
              height: `${virtualItem.size}px`,
              transform: `translateY(${virtualItem.start}px)`,
            }}
          />
        ))}
      </div>
    </div>
  );
}
```

