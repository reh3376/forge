### **Form Patterns with React Hook Form + Zod**
```typescript
// ✅ DO: Manufacturing form validation
const recipeSchema = z.object({
  name: z.string().min(1, "Recipe name required"),
  batchSize: z.number().min(1).max(10000),
  enzymeConfigurations: z.array(z.object({
    enzymeId: z.string(),
    dosageAmount: z.number().min(0),
    dosageUnit: z.enum(['ml', 'g', 'kg']),
    temperatureRange: z.object({
      min: z.number().min(0).max(100),
      max: z.number().min(0).max(100)
    })
  }))
});

export function RecipeForm() {
  const form = useForm<z.infer<typeof recipeSchema>>({
    resolver: zodResolver(recipeSchema),
    defaultValues: {
      name: '',
      batchSize: 1000,
      enzymeConfigurations: []
    }
  });

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-6">
        <FormField
          control={form.control}
          name="name"
          render={({ field }) => (
            <FormItem>
              <FormLabel>Recipe Name</FormLabel>
              <FormControl>
                <Input placeholder="Enter recipe name" {...field} />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />
        {/* Additional fields */}
      </form>
    </Form>
  );
}
```

### **Real-time Data Integration**
```typescript
// ✅ DO: MQTT/WebSocket integration patterns
export function useRealTimeTemperature(equipmentId: string) {
  const [temperature, setTemperature] = useState<number | null>(null);
  const [isConnected, setIsConnected] = useState(false);

  useEffect(() => {
    const mqtt = new MQTTClient({
      url: process.env.NEXT_PUBLIC_MQTT_URL!,
      topics: [`equipment/${equipmentId}/temperature`]
    });

    mqtt.on('connect', () => setIsConnected(true));
    mqtt.on('message', (topic, payload) => {
      const data = JSON.parse(payload.toString());
      setTemperature(data.value);
    });

    return () => mqtt.disconnect();
  }, [equipmentId]);

  return { temperature, isConnected };
}
```

## **State Management with Zustand**

### **Production Store Pattern**
```typescript
// ✅ DO: Domain-specific Zustand stores
interface ProductionState {
  activeOrders: ProductionOrder[];
  currentBatches: BatchData[];
  equipmentStatus: Record<string, EquipmentStatus>;
  // Actions
  updateBatchStatus: (batchId: string, status: BatchStatus) => void;
  addProductionOrder: (order: ProductionOrder) => void;
  updateEquipmentStatus: (equipmentId: string, status: EquipmentStatus) => void;
}

export const useProductionStore = create<ProductionState>((set, get) => ({
  activeOrders: [],
  currentBatches: [],
  equipmentStatus: {},
  
  updateBatchStatus: (batchId, status) => set(state => ({
    currentBatches: state.currentBatches.map(batch =>
      batch.id === batchId ? { ...batch, status } : batch
    )
  })),
  
  addProductionOrder: (order) => set(state => ({
    activeOrders: [...state.activeOrders, order]
  })),
  
  updateEquipmentStatus: (equipmentId, status) => set(state => ({
    equipmentStatus: { ...state.equipmentStatus, [equipmentId]: status }
  }))
}));
```

## **Data Fetching with React Query**

### **Manufacturing API Patterns**
```typescript
// ✅ DO: React Query for manufacturing data
export function useRecipes(filters?: RecipeFilters) {
  return useQuery({
    queryKey: ['recipes', filters],
    queryFn: () => api.recipes.getAll(filters),
    staleTime: 5 * 60 * 1000, // 5 minutes
    refetchInterval: 30 * 1000, // Refetch every 30 seconds for live data
  });
}

export function useBatchTelemetry(batchId: string) {
  return useQuery({
    queryKey: ['batch-telemetry', batchId],
    queryFn: () => api.batches.getTelemetry(batchId),
    refetchInterval: 1000, // Real-time updates
    enabled: !!batchId,
  });
}

export function useCreateRecipe() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: (recipe: CreateRecipeInput) => api.recipes.create(recipe),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['recipes'] });
      toast.success('Recipe created successfully');
    },
    onError: (error) => {
      toast.error(`Failed to create recipe: ${error.message}`);
    }
  });
}
```

