# E2E Testing Dockerfile for Next.js Frontend
# Builds from workspace root to handle shared packages
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    libc6-compat \
    curl

# Copy workspace root package.json files
COPY package*.json ./

# Copy shared package
COPY shared ./shared/

# Build shared package first
WORKDIR /app/shared
RUN npm ci && npm run build

# Go back to workspace root
WORKDIR /app

# Copy frontend package files
COPY frontend/package*.json ./frontend/

# Set working directory to frontend
WORKDIR /app/frontend

# Install frontend dependencies
RUN npm ci

# Copy frontend source code and configuration files
COPY frontend/app ./app/
COPY frontend/public ./public/
COPY frontend/components ./components/
COPY frontend/lib ./lib/
COPY frontend/hooks ./hooks/
COPY frontend/stores ./stores/
COPY frontend/types ./types/
COPY frontend/next.config.ts ./
COPY frontend/tailwind.config.ts ./
COPY frontend/postcss.config.mjs ./
COPY frontend/tsconfig*.json ./
COPY frontend/components.json ./
COPY frontend/.env* ./

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nextjs -u 1001

# Change ownership of the app directory
RUN chown -R nextjs:nodejs /app
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# Start the application in development mode
CMD ["npm", "run", "dev"] 